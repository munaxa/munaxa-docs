# Partial backend configuration for GitHub Actions (.github/workflows/terraform-eu-prod.yml).
#   terraform init -backend-config=../ci.s3.tfbackend
# The job's own credentials are the CI role (GitHub OIDC). The backend assumes the Production
# deployer from there, exactly like engineering.s3.tfbackend; the CI role itself has no access to
# the state bucket or its key.
assume_role = {
  role_arn        = "arn:aws:iam::800728620253:role/munaxa-docs/bootstrap/munaxa-docs-eu-prod-deployer"
  session_name    = "gha-run-terraform-state"
  source_identity = "github-actions"
}
