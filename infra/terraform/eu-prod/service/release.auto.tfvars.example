# Copy to release.auto.tfvars to deploy a release. Digests only; never a tag, never a credential.
# Fill from the release package of a "Publish images" run (docs/reports/production-release-package-<short>.md).
# The 041e827 package is GHCR-era and is not valid here: its images are not in ECR.
release_commit  = "<40-hex commit SHA>"
api_image       = "229251310592.dkr.ecr.eu-central-1.amazonaws.com/munaxa-docs/api@sha256:<64 hex>"
web_image       = "229251310592.dkr.ecr.eu-central-1.amazonaws.com/munaxa-docs/web@sha256:<64 hex>"
antivirus_image = "229251310592.dkr.ecr.eu-central-1.amazonaws.com/munaxa-docs/antivirus@sha256:<64 hex>"
