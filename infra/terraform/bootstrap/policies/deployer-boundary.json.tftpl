{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CeilingProductionServicesOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:*",
        "ecs:*",
        "elasticloadbalancing:*",
        "acm:*",
        "logs:*",
        "servicediscovery:*",
        "route53:*",
        "rds:*",
        "s3:*",
        "kms:*",
        "secretsmanager:*",
        "backup:*",
        "backup-storage:*",
        "cloudwatch:*",
        "sns:*",
        "events:*",
        "scheduler:*",
        "tag:*",
        "sts:GetCallerIdentity",
        "iam:Get*",
        "iam:List*",
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CeilingPassRoleToWorkloadServices",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::${account_id}:role/munaxa-docs/eu-prod/*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": ${pass_role_services_json}
        }
      }
    },
    {
      "Sid": "CeilingServiceLinkedRolesForUsedServices",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::${account_id}:role/aws-service-role/*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": ${service_linked_role_json}
        }
      }
    },
    {
      "Sid": "OnlyEuCentral1",
      "Effect": "Deny",
      "NotAction": [
        "iam:*",
        "sts:*",
        "route53:*",
        "s3:ListAllMyBuckets"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": "${region}"
        }
      }
    },
    {
      "Sid": "NeverTouchNonProductionTagged",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringEqualsIgnoreCase": {
          "aws:ResourceTag/Environment": ${non_production_tag_values}
        }
      }
    },
    {
      "Sid": "NeverTouchNonProductionByName",
      "Effect": "Deny",
      "Action": "*",
      "Resource": ${non_production_name_arns_json}
    },
    {
      "Sid": "NeverChangeProtectedVpcs",
      "Effect": "Deny",
      "Action": [
        "ec2:Create*",
        "ec2:Delete*",
        "ec2:Modify*",
        "ec2:Associate*",
        "ec2:Disassociate*",
        "ec2:Attach*",
        "ec2:Detach*",
        "ec2:Authorize*",
        "ec2:Revoke*",
        "ec2:Replace*"
      ],
      "Resource": "*",
      "Condition": {
        "ArnEquals": {
          "ec2:Vpc": ${protected_vpc_arns_json}
        }
      }
    },
    {
      "Sid": "ProtectBootstrapIdentityStateAndAudit",
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "arn:aws:iam::${account_id}:role/munaxa-docs/bootstrap/*",
        "arn:aws:iam::${account_id}:policy/munaxa-docs/bootstrap/*",
        "arn:aws:s3:::${state_bucket}/bootstrap/*",
        "arn:aws:s3:::${cloudtrail_bucket}",
        "arn:aws:s3:::${cloudtrail_bucket}/*"
      ]
    },
    {
      "Sid": "ProtectStateKeyByArn",
      "Effect": "Deny",
      "NotAction": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:GenerateDataKey",
        "kms:DescribeKey"
      ],
      "Resource": "${state_key_arn}"
    },
    {
      "Sid": "ProtectEverythingTaggedBootstrap",
      "Effect": "Deny",
      "NotAction": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:GenerateDataKey",
        "kms:DescribeKey"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Stack": "bootstrap"
        }
      }
    },
    {
      "Sid": "NeverReadSecretValues",
      "Effect": "Deny",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:BatchGetSecretValue"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IamWritesOnlyInsideProductionWorkloadPath",
      "Effect": "Deny",
      "Action": [
        "iam:Create*",
        "iam:Delete*",
        "iam:Put*",
        "iam:Attach*",
        "iam:Detach*",
        "iam:Update*",
        "iam:Tag*",
        "iam:Untag*",
        "iam:PassRole",
        "iam:Add*",
        "iam:Remove*",
        "iam:Set*",
        "iam:Upload*",
        "iam:Enable*"
      ],
      "NotResource": [
        "arn:aws:iam::${account_id}:role/munaxa-docs/eu-prod/*",
        "arn:aws:iam::${account_id}:policy/munaxa-docs/eu-prod/*",
        "arn:aws:iam::${account_id}:role/aws-service-role/*"
      ]
    },
    {
      "Sid": "WorkloadRolesMustCarryWorkloadBoundary",
      "Effect": "Deny",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "iam:PermissionsBoundary": "${workload_boundary_arn}"
        }
      }
    },
    {
      "Sid": "NoUsersKeysOrBoundaryRemoval",
      "Effect": "Deny",
      "Action": [
        "iam:*User*",
        "iam:*AccessKey*",
        "iam:*LoginProfile*",
        "iam:*OpenIDConnectProvider*",
        "iam:*SAMLProvider*",
        "iam:DeleteRolePermissionsBoundary"
      ],
      "Resource": "*"
    }
  ]
}
