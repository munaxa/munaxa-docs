{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcsProductionCluster",
      "Effect": "Allow",
      "Action": [
        "ecs:CreateCluster",
        "ecs:DeleteCluster",
        "ecs:UpdateCluster",
        "ecs:UpdateClusterSettings",
        "ecs:PutClusterCapacityProviders",
        "ecs:TagResource",
        "ecs:UntagResource"
      ],
      "Resource": "arn:aws:ecs:${region}:${account_id}:cluster/${prefix}"
    },
    {
      "Sid": "EcsProductionServices",
      "Effect": "Allow",
      "Action": [
        "ecs:CreateService",
        "ecs:UpdateService",
        "ecs:DeleteService",
        "ecs:TagResource",
        "ecs:UntagResource"
      ],
      "Resource": "arn:aws:ecs:${region}:${account_id}:service/${prefix}/*"
    },
    {
      "Sid": "EcsRegisterTaskDefinitionsTaggedProduction",
      "Effect": "Allow",
      "Action": "ecs:RegisterTaskDefinition",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Environment": "Production"
        }
      }
    },
    {
      "Sid": "EcsTagOnCreate",
      "Effect": "Allow",
      "Action": "ecs:TagResource",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Environment": "Production",
          "ecs:CreateAction": [
            "CreateCluster",
            "CreateService",
            "RegisterTaskDefinition",
            "RunTask"
          ]
        }
      }
    },
    {
      "Sid": "EcsProductionTaskDefinitions",
      "Effect": "Allow",
      "Action": [
        "ecs:DeleteTaskDefinitions",
        "ecs:TagResource",
        "ecs:UntagResource"
      ],
      "Resource": "arn:aws:ecs:${region}:${account_id}:task-definition/${prefix}-*:*"
    },
    {
      "Sid": "EcsDeregisterTaskDefinitions",
      "Effect": "Allow",
      "Action": "ecs:DeregisterTaskDefinition",
      "Resource": "*"
    },
    {
      "Sid": "EcsOperatorTasksOnProductionCluster",
      "Effect": "Allow",
      "Action": [
        "ecs:RunTask",
        "ecs:StartTask",
        "ecs:StopTask"
      ],
      "Resource": [
        "arn:aws:ecs:${region}:${account_id}:task-definition/${prefix}-*:*",
        "arn:aws:ecs:${region}:${account_id}:task/${prefix}/*"
      ],
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "arn:aws:ecs:${region}:${account_id}:cluster/${prefix}"
        }
      }
    },
    {
      "Sid": "CloudMapCreateTaggedProduction",
      "Effect": "Allow",
      "Action": [
        "servicediscovery:CreatePrivateDnsNamespace",
        "servicediscovery:CreateService",
        "servicediscovery:TagResource"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Environment": "Production"
        }
      }
    },
    {
      "Sid": "CloudMapManageProductionTagged",
      "Effect": "Allow",
      "Action": [
        "servicediscovery:DeleteNamespace",
        "servicediscovery:UpdatePrivateDnsNamespace",
        "servicediscovery:DeleteService",
        "servicediscovery:UpdateService"
      ],
      "Resource": [
        "arn:aws:servicediscovery:${region}:${account_id}:namespace/*",
        "arn:aws:servicediscovery:${region}:${account_id}:service/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Environment": "Production"
        }
      }
    },
    {
      "Sid": "Route53PrivateZoneForCloudMap",
      "Effect": "Allow",
      "Action": [
        "route53:CreateHostedZone",
        "route53:DeleteHostedZone",
        "route53:AssociateVPCWithHostedZone",
        "route53:DisassociateVPCFromHostedZone",
        "route53:ChangeTagsForResource",
        "route53:UpdateHostedZoneComment"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Route53RecordsOnlyInProductionNamespace",
      "Effect": "Allow",
      "Action": "route53:ChangeResourceRecordSets",
      "Resource": "arn:aws:route53:::hostedzone/*",
      "Condition": {
        "ForAllValues:StringLike": {
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": [
            "${cloudmap_namespace}",
            "*.${cloudmap_namespace}"
          ]
        }
      }
    },
    {
      "Sid": "ProductionLoadBalancer",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:CreateLoadBalancer",
        "elasticloadbalancing:DeleteLoadBalancer",
        "elasticloadbalancing:ModifyLoadBalancerAttributes",
        "elasticloadbalancing:SetSecurityGroups",
        "elasticloadbalancing:SetSubnets",
        "elasticloadbalancing:SetIpAddressType",
        "elasticloadbalancing:CreateListener",
        "elasticloadbalancing:DeleteListener",
        "elasticloadbalancing:ModifyListener",
        "elasticloadbalancing:ModifyListenerAttributes",
        "elasticloadbalancing:AddListenerCertificates",
        "elasticloadbalancing:RemoveListenerCertificates",
        "elasticloadbalancing:CreateRule",
        "elasticloadbalancing:DeleteRule",
        "elasticloadbalancing:ModifyRule",
        "elasticloadbalancing:SetRulePriorities",
        "elasticloadbalancing:CreateTargetGroup",
        "elasticloadbalancing:DeleteTargetGroup",
        "elasticloadbalancing:ModifyTargetGroup",
        "elasticloadbalancing:ModifyTargetGroupAttributes",
        "elasticloadbalancing:RegisterTargets",
        "elasticloadbalancing:DeregisterTargets",
        "elasticloadbalancing:AddTags",
        "elasticloadbalancing:RemoveTags"
      ],
      "Resource": [
        "arn:aws:elasticloadbalancing:${region}:${account_id}:loadbalancer/app/${prefix}-*/*",
        "arn:aws:elasticloadbalancing:${region}:${account_id}:listener/app/${prefix}-*/*",
        "arn:aws:elasticloadbalancing:${region}:${account_id}:listener-rule/app/${prefix}-*/*",
        "arn:aws:elasticloadbalancing:${region}:${account_id}:targetgroup/${prefix}-*/*"
      ]
    },
    {
      "Sid": "CertificatesRequestTaggedProduction",
      "Effect": "Allow",
      "Action": [
        "acm:RequestCertificate",
        "acm:AddTagsToCertificate"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Environment": "Production"
        }
      }
    },
    {
      "Sid": "CertificatesManageProductionTagged",
      "Effect": "Allow",
      "Action": [
        "acm:DeleteCertificate",
        "acm:AddTagsToCertificate",
        "acm:RemoveTagsFromCertificate",
        "acm:UpdateCertificateOptions",
        "acm:RenewCertificate"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Environment": "Production"
        }
      }
    },
    {
      "Sid": "ProductionLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:AssociateKmsKey",
        "logs:DisassociateKmsKey",
        "logs:PutMetricFilter",
        "logs:DeleteMetricFilter",
        "logs:TagResource",
        "logs:UntagResource",
        "logs:TagLogGroup",
        "logs:UntagLogGroup",
        "logs:GetLogEvents",
        "logs:FilterLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:${region}:${account_id}:log-group:/munaxa-docs/eu-prod/*",
        "arn:aws:logs:${region}:${account_id}:log-group:/munaxa-docs/eu-prod/*:*",
        "arn:aws:logs:${region}:${account_id}:log-group:/aws/rds/instance/${prefix}-*"
      ]
    }
  ]
}
