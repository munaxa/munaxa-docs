# Copy to terraform.tfvars (not committed). No secrets belong here.
#
# The administrator role that applies this bootstrap: admin.tamer reaches it from the management
# account (docs/operations/bootstrap-plan-runbooks.md). Not the engineering permission set.
state_admin_principal_arns = [
  "arn:aws:iam::657878534449:role/OrganizationAccountAccessRole",
]

# Optional, and not needed for CI: Claude's engineering role may assume the TEST deployer (as in
# Production). Leave unset unless that is decided separately.
# engineering_principal_arn = "arn:aws:iam::657878534449:role/aws-reserved/sso.amazonaws.com/eu-central-1/AWSReservedSSO_MunaxaAWSEngineeringAdmin_<suffix>"

# The account budget (USD 15 a month by default). false if this account refuses the Budgets API to
# its roles (the runbook checks); the budget is then created from the management account.
create_budget = true

# Who receives the TEST budget alerts (50 % / 100 % actual, 100 % forecast of monthly_budget_usd),
# for example the account's own mailbox. Required when create_budget = true.
budget_alert_emails = ["ops@example.com"]
