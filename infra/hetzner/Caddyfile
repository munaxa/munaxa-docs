# Munaxa Docs: the single HTTP entry point of a Hetzner deployment (ADR-0026 §3) — the PLAIN-HTTP
# configuration, published on 127.0.0.1 only. The routing rules are in caddy/routes.caddy, shared with
# Caddyfile.tls.
#
# TLS is NOT terminated here. This file serves until the TLS decision (D-2, ADR-0026 §11) is taken;
# with direct TLS on the host (the readiness report's recommendation for TEST), compose.tls.yaml
# replaces it with Caddyfile.tls. With a Cloudflare option, this file stays, behind that hop.
{
	# No admin API: nothing in this deployment reconfigures the proxy at runtime.
	admin off
	# Certificates are not this process's job (above), and it must not try to obtain any.
	auto_https off
	# The client address. Caddy does not trust an incoming X-Forwarded-For unless the peer is listed
	# here, so by default every hop behind it sees the real TCP peer. Once the TLS decision names the
	# hop in front of Caddy (cloudflared, or Cloudflare's published ranges), list it here and add
	# `client_ip_headers CF-Connecting-IP` — and test it (ADR-0026 §10, gap G-5) — or every browser
	# will share one sign-in rate-limit allowance.
	# servers {
	# 	trusted_proxies static <the hop in front of this proxy>
	# 	client_ip_headers CF-Connecting-IP
	# }
}

import /etc/caddy/routes.caddy

:8080 {
	import munaxa_routes
}

# The container's own health check. Bound to the loopback interface inside the container and never
# published, so it is not reachable from the internet or from the other containers.
http://127.0.0.1:8081 {
	respond "ok" 200
}
