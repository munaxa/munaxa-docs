# What a deployment runs — passed to Compose with `--env-file deploy.env` (README.md §3).
# Not secret, but specific to one environment (TEST or production) of one product. Copy, then fill in.

# One name per product and environment, so two stacks on one host can never share a volume.
DOCS_PROJECT_NAME=munaxa-docs-prod

# Where this environment's secret files live: api.env, postgres.env, redis.env, operator.env,
# tenants.json, operator-tenants.json. Outside the repository checkout; directory 0700, files 0600,
# owned by root. Never in git.
DOCS_CONFIG_DIR=/etc/munaxa-docs

# The release. ALWAYS immutable digests from publish-images.yml's job summary, never a tag:
# a rollback target is the digest of a release that already ran here (go-live-runbook.md §20).
DOCS_API_IMAGE=ghcr.io/munaxa/munaxa-docs-api@sha256:<64-hex digest>
DOCS_WEB_IMAGE=ghcr.io/munaxa/munaxa-docs-web@sha256:<64-hex digest>
DOCS_ANTIVIRUS_IMAGE=ghcr.io/munaxa/munaxa-docs-antivirus@sha256:<64-hex digest>

# Third-party images. compose.yaml carries version-pinned defaults; production pins digests here.
# DOCS_PROXY_IMAGE=caddy:2.10.2-alpine@sha256:<digest>
# DOCS_POSTGRES_IMAGE=postgres:16.10-alpine@sha256:<digest>
# DOCS_REDIS_IMAGE=redis:7.4-alpine@sha256:<digest>

# The one published port. 127.0.0.1 until the TLS decision (ADR-0026 §11) names what connects to it.
DOCS_HTTP_BIND=127.0.0.1
DOCS_HTTP_PORT=8080
