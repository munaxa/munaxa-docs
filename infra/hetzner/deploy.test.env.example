# The disposable TEST environment's deploy.env (readiness report §5.4) — NOT YET USED: nothing has
# been provisioned. Copy to deploy.env at the root of the release checkout on the TEST server, fill
# in every `<…>`, then run `infra/hetzner/ops/check-deploy-env.sh deploy.env --on-host` until it
# reports nothing wrong. Not secret; secrets are in DOCS_CONFIG_DIR (config/*.example).
#
# Started with direct TLS (TLS option C; compose.tls.yaml):
#   C="docker compose --env-file deploy.env -f infra/hetzner/compose.yaml -f infra/hetzner/compose.tls.yaml"
#
# While the server has no separate backup disk and no off-server copy (an owner decision for this
# disposable TEST, test data only), add the deferral overlay and check with its flag
# (README.md §4, "TEST with backups deferred"):
#   C="$C -f infra/hetzner/compose.backups-deferred.yaml"
#   infra/hetzner/ops/check-deploy-env.sh deploy.env --on-host --backups-deferred

DOCS_PROJECT_NAME=munaxa-docs-test
DOCS_CONFIG_DIR=/etc/munaxa-docs

# The release: source commit 5ce39875906a575709614a30db6d9069cbbf1c19, published and verified by
# publish-images.yml in GitHub Actions run 39333554355 (tag image/<that commit>).
DOCS_API_IMAGE=ghcr.io/munaxa/munaxa-docs-api@sha256:c56a6ba99081165dc767f0d8647dc4aaf2a1b575e8584aa32f716e12599be76d
DOCS_WEB_IMAGE=ghcr.io/munaxa/munaxa-docs-web@sha256:721b813c4bcb39e46ca6a1ea92f7e513454a1fe60d7fc79fcc494e3027ff1f56
DOCS_ANTIVIRUS_IMAGE=ghcr.io/munaxa/munaxa-docs-antivirus@sha256:129b9209d48716a1bc84b1be1807df031640c4df37b030558acf011e47e8b02d
DOCS_POSTGRES_IMAGE=ghcr.io/munaxa/munaxa-docs-postgres@sha256:7f9be0c709e6d4a24461d718088e4cb80cc063b82c52377bcd43cd721c3fef17
# Third-party images: the multi-architecture index digests of these tags, read on 2026-10-19 with
#   docker buildx imagetools inspect caddy:2.10.2-alpine --format '{{json .Manifest.Digest}}'
#   docker buildx imagetools inspect redis:7.4-alpine --format '{{json .Manifest.Digest}}'
# Read them again before a release; a tag can move, the digest cannot.
DOCS_PROXY_IMAGE=caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
DOCS_REDIS_IMAGE=redis:7.4-alpine@sha256:858f009f9709ce576febc734aa78b8f6d624b82571f9ddb6bda4377c833b3499

# Only the TLS overlay publishes anything (80 and 443); this listener stays on loopback.
DOCS_HTTP_BIND=127.0.0.1
DOCS_HTTP_PORT=8080

# Direct TLS (compose.tls.yaml). Before the first start, ports 80/443 must be open and the host
# name needs ONE DNS record in the munaxa.com zone: `A nonprod-docs <the server's primary IPv4>`,
# DNS only (not proxied: Caddy must terminate TLS and see client addresses itself). No AAAA: the
# overlay publishes on 0.0.0.0, IPv4 only, and Let's Encrypt prefers IPv6 when an AAAA exists.
DOCS_PUBLIC_HOSTNAME=nonprod-docs.munaxa.com
DOCS_ACME_EMAIL=<required: the ACME account contact address>
# Let's Encrypt staging for the first start (untrusted certificate, no rate-limit risk); remove this
# line, and the staging data from the caddy-data volume, to obtain the real certificate.
DOCS_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# Backups: a separate block-storage volume, mounted here, uid 70, mode 0700. With the deferral
# overlay nothing mounts or writes it, but compose.yaml still requires both settings to render, and
# the two recipients are still checked: generate two TEST-only age key pairs off the server.
DOCS_BACKUP_DIR=/mnt/munaxa-backup
DOCS_BACKUP_AGE_RECIPIENTS=<required: age1… of holder one>,<required: age1… of holder two>
DOCS_OFFSITE_STATE_DIR=/var/lib/munaxa-docs/offsite
