# The disposable TEST environment's deploy.env (readiness report §5.4) — NOT YET USED: nothing has
# been provisioned. Copy to deploy.env at the root of the release checkout on the TEST server, fill
# in every `<…>`, then run `infra/hetzner/ops/check-deploy-env.sh deploy.env --on-host` until it
# reports nothing wrong. Not secret; secrets are in DOCS_CONFIG_DIR (config/*.example).
#
# Started with direct TLS (TLS option C; compose.tls.yaml):
#   C="docker compose --env-file deploy.env -f infra/hetzner/compose.yaml -f infra/hetzner/compose.tls.yaml"

DOCS_PROJECT_NAME=munaxa-docs-test
DOCS_CONFIG_DIR=/etc/munaxa-docs

# The release: digests from publish-images.yml's job summary for one image/<sha> tag. None exists
# yet for this branch; the owner publishes when a commit is chosen for TEST.
DOCS_API_IMAGE=ghcr.io/munaxa/munaxa-docs-api@sha256:<required: 64-hex digest>
DOCS_WEB_IMAGE=ghcr.io/munaxa/munaxa-docs-web@sha256:<required: 64-hex digest>
DOCS_ANTIVIRUS_IMAGE=ghcr.io/munaxa/munaxa-docs-antivirus@sha256:<required: 64-hex digest>
DOCS_POSTGRES_IMAGE=ghcr.io/munaxa/munaxa-docs-postgres@sha256:<required: 64-hex digest>
DOCS_PROXY_IMAGE=caddy:2.10.2-alpine@sha256:<required: digest, read when the release is cut>
DOCS_REDIS_IMAGE=redis:7.4-alpine@sha256:<required: digest, read when the release is cut>

# Only the TLS overlay publishes anything (80 and 443); this listener stays on loopback.
DOCS_HTTP_BIND=127.0.0.1
DOCS_HTTP_PORT=8080

# Direct TLS (compose.tls.yaml). Before the first start, ports 80/443 must be open and the host
# name needs ONE DNS record in the munaxa.com zone: `A nonprod-docs <the server's primary IPv4>`,
# DNS only (not proxied: Caddy must terminate TLS and see client addresses itself). No AAAA: the
# overlay publishes on 0.0.0.0, IPv4 only, and Let's Encrypt prefers IPv6 when an AAAA exists.
DOCS_PUBLIC_HOSTNAME=nonprod-docs.munaxa.com
DOCS_ACME_EMAIL=<required: the ACME account contact address>
# Let's Encrypt staging for the first start (untrusted certificate, no rate-limit risk); remove this
# line, and the staging data from the caddy-data volume, to obtain the real certificate.
DOCS_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# Backups: the 50 GB Hetzner Volume, mounted here, uid 70, mode 0700.
DOCS_BACKUP_DIR=/mnt/munaxa-backup
DOCS_BACKUP_AGE_RECIPIENTS=<required: age1… of holder one>,<required: age1… of holder two>
DOCS_OFFSITE_STATE_DIR=/var/lib/munaxa-docs/offsite
