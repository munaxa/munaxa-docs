# One tenant's first administrator — the D-1 procedure (go-live-runbook.md §1a, §6 step 5).
# Write to ${DOCS_CONFIG_DIR}/provision.env (mode 0600) for ONE run of the `provision` service, then
# DELETE it. PLACEHOLDERS ONLY. ADMIN_PASSWORD is a secret; hand it to the customer out of band.
TENANT_ID=<that tenant's id from tenants.json>
TENANT_SLUG=<that tenant's slug>
TENANT_NAME=<the organisation's display name>
ADMIN_EMAIL=<administrator email>
ADMIN_NAME=<administrator name>
ADMIN_PASSWORD=<temporary password>
DATABASE_URL=postgresql://edms_app:<EDMS_APP_PASSWORD>@postgres:5432/edms_<that tenant's slug>
