# Operator-only credentials — copy to ${DOCS_CONFIG_DIR}/operator.env (mode 0600). PLACEHOLDERS ONLY.
# Read only by `db-admin bootstrap`. The running API never receives this file (ADR-0021 §3).
# Hex values (openssl rand -hex 32) are safe inside connection URLs.

# Schema owner: migrations only (operator-tenants.json).
EDMS_OWNER_PASSWORD=<generate>
# Application role (tenants.json, and api.env's DATABASE_URL).
EDMS_APP_PASSWORD=<generate>
# BYPASSRLS + pg_read_all_data: logical backups only.
EDMS_BACKUP_PASSWORD=<generate>
