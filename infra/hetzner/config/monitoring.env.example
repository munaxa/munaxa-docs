# Alert delivery for ops/monitor.sh (docs/operations/monitoring.md §4). Copy to
# ${DOCS_CONFIG_DIR}/monitoring.env, mode 0600, owned by root. Parsed, never executed.
# EVERY VALUE BELOW IS A PLACEHOLDER; monitor.sh refuses to run while any `<…>` remains.

# REQUIRED. The dead-man's switch: pinged after every passing host check. A missed ping pages.
# It is a credential: whoever holds it can silence the alert. https:// only.
HEARTBEAT_URL=<required: the ping URL of the heartbeat check (5-minute period, 10-minute grace)>

# REQUIRED. Who receives the alerts. Recorded here so nobody has to guess; the actual routing is
# configured in the monitoring service itself. Not sent anywhere by monitor.sh.
ALERT_CONTACT=<required: the named person (and a second) who is paged>

# Optional. The heartbeat service's failure endpoint (many services accept the ping URL + /fail),
# so a finding pages at once instead of after the grace period. Receives the finding lines only.
# HEARTBEAT_FAIL_URL=<optional: the failure-signal URL of the same check>

# Optional. A webhook that accepts {"text": "..."} (most chat and alerting tools). Finding lines only.
# ALERT_WEBHOOK_URL=<optional: an incoming-webhook URL>

# Optional. A short label in the message, to tell environments apart (letters, digits, . _ -).
MONITOR_LABEL=munaxa-docs-test
