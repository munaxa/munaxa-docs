# The API's environment — copy to ${DOCS_CONFIG_DIR}/api.env (mode 0600) and fill in.
# PLACEHOLDERS ONLY. A real value in this file, or anywhere in git, is a prohibited action
# (docs/architecture/17-security-architecture.md §7).
#
# Validated at boot by apps/api/src/core/config/configuration.ts; a missing or unsafe production value
# stops the process and names the variable. The full reference is docs/operations/go-live-runbook.md §5
# and .env.example. compose.yaml already fixes NODE_ENV=production, PORT, DEPLOYMENT_PROFILE=CLOUD,
# TENANT_CATALOGUE_PATH, AV_DRIVER/AV_ICAP_URL, QUEUE_CONSUMERS_ENABLED, OPENAPI_ENABLED=false and
# TRUST_PROXY; do not set them here.
#
# Generate each secret with: openssl rand -hex 32   (hex: safe inside a connection URL)

LOG_LEVEL=info

# --- Database and Redis ---------------------------------------------------------------------------
# Required even with a catalogue (STG-5): one tenant's edms_app URL. Every tenant's own URL is in
# tenants.json. Pool per tenant; tenants × pool must fit max_connections (ADR-0024 §2.5).
DATABASE_URL=postgresql://edms_app:<EDMS_APP_PASSWORD>@postgres:5432/edms_<first-tenant-slug>
DATABASE_POOL_SIZE=5
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379

# --- Keys (each ≥ 32 characters; see the warnings) ----------------------------------------------
# Rotating it ends every session.
JWT_ACCESS_SECRET=<generate>
# Keep EVERY version for as long as signed records are retained; losing it makes past signatures
# unverifiable (deployment.md §4).
SIGNATURE_WITNESS_SECRET=<generate>
AUDIT_CHECKPOINT_SECRET=<generate>
# Losing it makes every enrolled authenticator unreadable.
MFA_TOTP_SEALING_KEY=<generate>

# --- Public addresses -------------------------------------------------------------------------------
CORS_ORIGINS=https://<web host>
WEB_BASE_URL=https://<web host>
# The public origin browsers reach previews through (the proxy routes /api/v1/preview/stream* to the API).
STORAGE_PUBLIC_URL=https://<web host>

# --- Object storage (external; ADR-0026 §6 — provider not yet chosen, gate P-1) ------------------
# S3 for Hetzner Object Storage or any S3-compatible store; R2 for Cloudflare R2. A key pair scoped
# to this one bucket. STORAGE_CREDENTIALS_SOURCE stays at its default (STATIC): ECS_TASK_ROLE is AWS-only.
STORAGE_DRIVER=<S3 | R2>
STORAGE_BUCKET=<bucket>
STORAGE_REGION=<provider region>
STORAGE_ENDPOINT=https://<provider endpoint>
STORAGE_FORCE_PATH_STYLE=<true | false, per provider>
STORAGE_ACCESS_KEY_ID=<from the provider>
STORAGE_SECRET_ACCESS_KEY=<from the provider>

# --- Mail (ADR-0026 §7 — provider not yet chosen) --------------------------------------------------
# Either RESEND …
# MAIL_DRIVER=RESEND
# MAIL_RESEND_API_KEY=<from Resend>
# (The mail adapters do not go through OUTBOUND_HTTP_ALLOWLIST; that list is for tenant-configured URLs.)
# … or SMTP on 587 with STARTTLS (Hetzner may block outbound 25 and 465 — verify; ADR-0026 §7).
MAIL_DRIVER=SMTP
MAIL_SMTP_HOST=<relay host>
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURITY=STARTTLS
MAIL_SMTP_USERNAME=<from the provider>
MAIL_SMTP_PASSWORD=<from the provider>
MAIL_FROM_ADDRESS=<no-reply@your sending domain>
MAIL_FROM_NAME=Munaxa Docs

# --- Optional -------------------------------------------------------------------------------------
# Prometheus exposition at /api/metrics (never routed publicly by the proxy).
# METRICS_DRIVER=PROMETHEUS
# METRICS_SCRAPE_TOKEN=<generate>
# OUTBOUND_HTTP_ALLOWLIST=<hosts webhooks/federation/audit push may reach; empty = none>
# SENTRY_DSN and OTEL_EXPORTER_OTLP_ENDPOINT must stay unset: they are refused at boot.
