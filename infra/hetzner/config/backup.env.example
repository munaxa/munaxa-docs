# The db-backup service's credential — copy to ${DOCS_CONFIG_DIR}/backup.env (mode 0600).
# PLACEHOLDER ONLY. The same value as EDMS_BACKUP_PASSWORD in operator.env: the edms_backup role
# (BYPASSRLS, pg_read_all_data, REPLICATION), set by `db-admin bootstrap`.
PGPASSWORD=<the EDMS_BACKUP_PASSWORD value>
