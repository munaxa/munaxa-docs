# Copy to .env and fill in. Placeholders only — a real secret in this file is a prohibited
# action (docs/architecture/17-security-architecture.md §7).
#
# Every variable here is validated at boot by apps/api/src/core/config/configuration.ts. A
# missing or malformed value fails startup rather than surfacing at the first request.

NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug

# --- Which companies this deployment serves ---------------------------------------------------
#
# Every company gets its own database, its own storage location and its own search index
# (docs/architecture/adr/0015-database-per-tenant.md). A process therefore cannot start without
# knowing which companies it serves — there is no default database to fall back on.
#
# There are two ways to say it, and a configuration that says both fails to start.
#
# ON PREMISE — one company, derived from the variables below. Nothing else to configure.
DEPLOYMENT_PROFILE=ON_PREMISE
TENANT_SLUG=acme
# Stable across restarts: it is written into every row and carried in every token.
# Generate once with: node -e "console.log(crypto.randomUUID())"
TENANT_ID=00000000-0000-4000-8000-000000000000

# CLOUD — many companies, from a catalogue. Set DEPLOYMENT_PROFILE=CLOUD and give exactly one of
# these instead of TENANT_SLUG/TENANT_ID. `{slug}` is substituted per tenant, so adding a company
# is one line rather than a copied connection string with one word changed.
#
# TENANT_CATALOGUE_PATH=/etc/munaxa/tenants.json
# TENANT_CATALOGUE={"defaults":{"databaseUrlTemplate":"postgresql://edms_app:…@db/edms_{slug}","migrationUrlTemplate":"postgresql://edms_owner:…@db/edms_{slug}","storage":{"driver":"S3","container":"munaxa-docs","prefixTemplate":"tenants/{slug}"},"search":{"indexTemplate":"docs-{slug}"}},"tenants":[{"id":"…","slug":"acme"}]}

# The application role. It has no BYPASSRLS; migrations use DATABASE_MIGRATION_URL.
# Under a catalogue these are the fallback for a tenant that states no database of its own.
DATABASE_URL=postgresql://edms_app:local-development-only@localhost:5433/edms
DATABASE_MIGRATION_URL=postgresql://edms_owner:local-development-only@localhost:5433/edms
# Per tenant, not per process: the connection ceiling is this times DATABASE_MAX_TENANT_CLIENTS,
# and PostgreSQL's max_connections is what it has to fit inside.
DATABASE_POOL_SIZE=10
# How many tenant databases one process holds connections to at once. The least recently used is
# disconnected beyond this, which costs a reconnect and never costs a single-tenant install
# anything.
DATABASE_MAX_TENANT_CLIENTS=25

REDIS_URL=redis://localhost:6380

# Background work — Phase 4, the first phase with any.
#
# Every process enqueues; this says which ones *consume*. It defaults to true because a
# single-server installation is one process, and a deployment where nothing consumes a lane is a
# deployment where approval deadlines silently never fire. Set it to false on the API instances of a
# horizontally scaled deployment and true on the one that runs the workers.
QUEUE_CONSUMERS_ENABLED=true
# How many outbox rows the dispatcher claims per pass, and how long it waits when a pass came back
# short. A full batch goes again immediately, so a burst drains rather than trickling.
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_MS=2000

# At least 32 characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# NONE means "not configured": the port is bound to an adapter that fails naming the variable
# that would fix it. Production refuses to start with NONE (configuration.ts).
#
# The bucket, container or root directory. Each company's bytes live under its own prefix inside
# it, added and checked by the storage port itself — so a shared bucket and a bucket per company
# are the same code path.
#
# LOCAL is allowed in on-premise production and refused in cloud production: a filesystem is not
# shared between instances, so a document uploaded through one would be missing from the next.
#
# Two drivers exist as of Phase 3. `S3` and `R2` are the same adapter: they differ in endpoint,
# region and addressing style, which is configuration.
#
#   LOCAL   the filesystem, for a single-server installation. The API serves the bytes itself,
#           through two streaming endpoints authorised by a signed capability — see
#           docs/architecture/11-storage-architecture.md §2.
#   S3/R2   presigned URLs, browser straight to the store. AWS, MinIO, Cloudflare R2.
STORAGE_DRIVER=NONE
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
# Both halves of the pair, or neither — a deployment on an instance role supplies neither, and
# supplying exactly one is the misconfiguration boot validation refuses.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_SESSION_TOKEN=
# MinIO and most self-hosted stores put the bucket in the path; AWS and R2 put it in the hostname.
STORAGE_FORCE_PATH_STYLE=false
# LOCAL only: where files are written. Each company's prefix is a directory inside it.
STORAGE_LOCAL_ROOT=./.storage
# LOCAL only: where a browser reaches the API's own transfer endpoints. The API cannot infer this
# from the socket it listens on when it sits behind a reverse proxy.
STORAGE_PUBLIC_URL=http://localhost:3001
# How long a presigned upload or download URL lives, and the ceiling on any one file.
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_MAX_UPLOAD_BYTES=2147483648
#
# The local stack in infra/docker-compose.yml runs MinIO for exactly this. To use it:
#   STORAGE_DRIVER=S3
#   STORAGE_BUCKET=munaxa-docs
#   STORAGE_ENDPOINT=http://localhost:9000
#   STORAGE_FORCE_PATH_STYLE=true
#   STORAGE_ACCESS_KEY_ID=edms-local
#   STORAGE_SECRET_ACCESS_KEY=local-development-only
SEARCH_DRIVER=POSTGRES
#
# Phase 8 — search. POSTGRES is the built engine (ADR-0008); OPENSEARCH is accepted by the
# schema and refused at boot until its adapter exists. The knobs below are the coalescing
# window, the rebuild's batch/resume granularity, the per-person recent-search cap, and the
# most body text one index entry stores.
# SEARCH_DEBOUNCE_MS=1000
# SEARCH_REBUILD_BATCH_SIZE=200
# SEARCH_RECENT_LIMIT=20
# SEARCH_MAX_BODY_CHARS=1000000
#
# Phase 9 — audit and compliance.
#
# The key the daily chain checkpoint is signed with. 13 §4 requires checkpoints to live "in a
# separate store so an attacker with database access alone cannot rewrite history undetected";
# the store is object storage, and this is what stops an attacker who reaches the bucket as well
# from forging one — so it is held here, in neither the database nor the bucket. **Production
# refuses to boot without it.** A development environment without one still verifies the chain and
# reports `checkpointed: false` rather than writing an unsigned marker that looks like evidence.
# AUDIT_CHECKPOINT_SECRET=change-me-at-least-thirty-two-characters

# The key the server witnesses an electronic signature with (Phase 16, ADR-0017). Its own secret
# rather than the checkpoint's: a checkpoint may be rotated freely once verified, while a signature
# must keep verifying for as long as the record is retained. Required in production; without one the
# product refuses to sign rather than writing a signature nothing witnessed.
# SIGNATURE_WITNESS_SECRET=change-me-at-least-thirty-two-characters
#
# Read auditing is buffered (13 §5): a page view must not cost a transaction, and must not take the
# tenant's audit advisory lock inline. Flush when either the count or the interval is reached; past
# the hard bound, writes go through synchronously rather than being dropped — so the hard bound is
# also "how much evidence a crash would lose".
# AUDIT_READ_BUFFER_SIZE=200
# AUDIT_READ_BUFFER_MAX=1000
# AUDIT_READ_FLUSH_INTERVAL_MS=2000
#
# The nightly verification's granularity, and the ceiling on one pass. A deployment meeting years
# of trail on its first night catches up over several, checkpointing where each pass stopped.
# AUDIT_VERIFY_BATCH_SIZE=5000
# AUDIT_VERIFY_MAX_EVENTS=200000
#
# Rows read per batch while an evidence bundle streams to storage, and how much of a streamed
# object is held before a part is sent (5 MiB is every S3-compatible store's multipart floor).
# AUDIT_EXPORT_BATCH_SIZE=2000
# STORAGE_STREAM_PART_BYTES=8388608
#
# Which rendering rule an evidence bundle's events.csv is written under (Phase 18). The default
# neutralises spreadsheet formulas, which uniform quoting never did; RFC4180 is Phase 9's exact
# behaviour, kept so a bundle produced before the change can be reproduced byte-for-byte and checked
# against the digest in the manifest somebody already holds. Whichever is used is recorded *on* the
# manifest, which is what makes the difference legible.
# AUDIT_EXPORT_CSV_PROFILE=RFC4180_FORMULA_NEUTRALISED
#
# The rolling integrity verifier (Phase 18, 17 §8): how many blobs one nightly pass reads back and
# re-hashes, and how large a blob it will attempt. The second is a bound rather than a preference —
# the storage port answers with a whole Buffer, so an unbounded pass would hold a 2 GB scan in a
# background lane's memory. A blob above it is stamped as looked-at and left UNVERIFIED, which stops
# it being returned by every subsequent pass for ever.
# STORAGE_INTEGRITY_BATCH_SIZE=200
# STORAGE_INTEGRITY_MAX_BYTES=134217728
OCR_DRIVER=NONE
AV_DRIVER=NONE

# The key a TOTP secret is sealed with at rest (Phase 18, ADR-0020).
#
# Its own key rather than one derived from JWT_ACCESS_SECRET, which is what Phase 14 did: that left
# the two on one rotation clock, so rotating the token secret — a routine act — silently made every
# enrolled authenticator unreadable. Sealed values name the key that sealed them, both keys unseal,
# and a stale row re-seals the next time its owner proves a code.
#
# Required in production. A development machine without one keeps Phase 14's derivation and behaves
# byte for byte as it did. At least 32 characters.
# MFA_TOTP_SEALING_KEY=

# Phase 12 — notifications (`docs/architecture/18-notification-architecture.md`).
#
# NONE is correct for a development machine: in-app notifications are unaffected, because the row
# *is* the delivery, and every refused email is recorded rather than silently dropped. RESEND is the
# hosted driver; SMTP arrived in Phase 18 and is the on-premise one.
MAIL_DRIVER=NONE
# MAIL_RESEND_API_KEY=
# MAIL_RESEND_ENDPOINT=https://api.resend.com/emails
# MAIL_TIMEOUT_MS=15000
#
# MAIL_DRIVER=SMTP — the relay an on-premise installation sends through (Phase 18, 18 §3).
#
# STARTTLS on 587 is the default and the modern arrangement; TLS is implicit TLS on 465; NONE is a
# relay on the same host and is the only value that refuses credentials, because both authentication
# mechanisms base64 the password and base64 is an encoding rather than a protection. Production
# refuses NONE outright, and refuses an unvalidated certificate.
#
# MAIL_SMTP_HOST=relay.internal
# MAIL_SMTP_PORT=587
# MAIL_SMTP_SECURITY=STARTTLS
# MAIL_SMTP_USERNAME=
# MAIL_SMTP_PASSWORD=
# Turning validation off is for a relay with an internal certificate authority nobody installed. It
# is a variable so that choosing it is an act an auditor can find, rather than a default.
# MAIL_SMTP_REJECT_UNAUTHORIZED=true
# The name announced in EHLO; some relays refuse one that does not resolve, and a container's
# hostname never does. Defaults to WEB_BASE_URL's host.
# MAIL_SMTP_CLIENT_NAME=docs.example.com
#
# Who the mail comes from. Deployment configuration rather than a tenant setting: the address has
# to be one the sending domain is authorised for, and SPF, DKIM and DMARC are properties of the
# deployment. Required whenever MAIL_DRIVER names a provider.
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME=Munaxa Docs
#
# Where a notification's deep links point. The link grants nothing — every route behind one
# resolves through ordinary authorisation (18 §8) — but it has to be reachable from a browser,
# which the API cannot infer from the socket it listens on.
WEB_BASE_URL=http://localhost:3000

# Phase 7 — preview rendering.
#
# The office-to-PDF converter is the one external tool the preview pipeline may use, and it is a
# deployment decision: NONE degrades honestly (Office documents keep their extracted text and lose
# their paginated rendition), LIBREOFFICE shells out to the pinned binary in a per-conversion
# sandbox. OCR_DRIVER=TESSERACT likewise shells out to a system tesseract (ara+eng by default).
OFFICE_DRIVER=NONE
# OFFICE_LIBREOFFICE_PATH=soffice
# OCR_TESSERACT_PATH=tesseract
# OCR_LANGUAGES=ara+eng
#
# The render sandbox's resource caps — capacity statements, not correctness ones. The defaults
# suit a small worker; every value trades "how large a document previews" against cost per job.
# PREVIEW_RENDER_TIMEOUT_MS=60000
# PREVIEW_MAX_SOURCE_BYTES=134217728
# PREVIEW_MAX_OUTPUT_BYTES=67108864
# PREVIEW_MAX_PAGES=500
# PREVIEW_MAX_TEXT_BYTES=2097152
# PREVIEW_MAX_ARCHIVE_ENTRIES=4096
# PREVIEW_MAX_ARCHIVE_EXPANSION_RATIO=200
# PREVIEW_MAX_PIXELS=40000000

# The interactive explorer at /api/docs. Refused in production — Phase 17 split it from the
# document below, because they have two audiences: an explorer is a surface, a schema is a contract.
OPENAPI_ENABLED=true
# The machine-readable schema at /api/openapi.json. Served in every environment, production
# included: refusing to publish it there means the one deployment whose contract anybody cares
# about is the one that will not state it.
# OPENAPI_DOCUMENT_ENABLED=true

# --- The outbound boundary (Phase 17, 17 §6) -------------------------------------------------
#
# The hosts this deployment will make an outbound request to, comma-separated. An entry with a
# leading dot covers its subdomains (`.hooks.example.com`); one without covers exactly itself.
#
# **Empty is the default, and empty means nothing is reachable** — so webhooks, federated sign-in
# and audit push are all inert until an operator names a host. That is the correct posture for a
# control whose failure mode is the server attacking its own network: a webhook endpoint, an OIDC
# discovery document and a SIEM collector are all URLs a *tenant administrator* types.
#
# This is an operator's setting and the only one in the integration platform a tenant cannot edit.
# A boundary the people inside it can move is not a boundary.
# OUTBOUND_HTTP_ALLOWLIST=hooks.example.com,.collectors.example.net
#
# For a development collector on a laptop, and nothing else. Refused in production: a webhook over
# plaintext puts the payload and its signature on the wire for anybody on the path.
# OUTBOUND_HTTP_ALLOW_INSECURE=false
# OUTBOUND_HTTP_MAX_RESPONSE_BYTES=65536

# Where an OIDC provider returns the browser. Configured rather than read from the request, which
# is the check whose absence is the open-redirect in every hand-rolled OIDC integration. Defaults
# to WEB_BASE_URL + /auth/federation/callback.
# FEDERATION_REDIRECT_URI=

# --- Observability (Phase 18, 20 §5) ----------------------------------------------------------
#
# Phase 0.5 declared the metrics port and bound it to nothing on purpose: which backend a deployment
# scrapes is an operational decision. PROMETHEUS exposes an in-process registry at GET /api/metrics
# for a scraper to **pull** — no outbound request at all, which is what keeps Phase 17's outbound
# boundary the only one. NONE is a no-op rather than a refusal, because a deployment with no metrics
# works and is simply unobserved.
# METRICS_DRIVER=NONE
#
# Required whenever the driver is real, in every environment. The scrape body is queue depths, error
# rates and authorisation-refusal counts by permission: no tenant's data, and a great deal of
# reconnaissance. At least 32 characters; generate with: openssl rand -base64 48
# METRICS_SCRAPE_TOKEN=
#
# The registry's series bound, and how often lane depth and the outbox backlog are sampled. The
# metric catalogue already refuses any label it does not declare; this is the backstop for a label
# whose set is bounded in principle and large in practice.
# METRICS_MAX_SERIES=5000
# METRICS_SAMPLE_INTERVAL_MS=15000
#
# SENTRY_DSN and OTEL_EXPORTER_OTLP_ENDPOINT are **refused at boot**, deliberately. Neither has an
# exporter in this build, and a variable that is accepted and ignored is worse than one that is
# refused: an operator who sets it believes errors are being exported, and finds out otherwise
# during the incident it was set for. Errors are on the structured log stream.

# The web app
NEXT_PUBLIC_API_URL=http://localhost:3001
