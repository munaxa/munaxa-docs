# Copy to .env and fill in. Placeholders only — a real secret in this file is a prohibited
# action (docs/architecture/17-security-architecture.md §7).
#
# Every variable here is validated at boot by apps/api/src/core/config/configuration.ts. A
# missing or malformed value fails startup rather than surfacing at the first request.

NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug

# --- Which companies this deployment serves ---------------------------------------------------
#
# Every company gets its own database, its own storage location and its own search index
# (docs/architecture/adr/0015-database-per-tenant.md). A process therefore cannot start without
# knowing which companies it serves — there is no default database to fall back on.
#
# There are two ways to say it, and a configuration that says both fails to start.
#
# ON PREMISE — one company, derived from the variables below. Nothing else to configure.
DEPLOYMENT_PROFILE=ON_PREMISE
TENANT_SLUG=acme
# Stable across restarts: it is written into every row and carried in every token.
# Generate once with: node -e "console.log(crypto.randomUUID())"
TENANT_ID=00000000-0000-4000-8000-000000000000

# CLOUD — many companies, from a catalogue. Set DEPLOYMENT_PROFILE=CLOUD and give exactly one of
# these instead of TENANT_SLUG/TENANT_ID. `{slug}` is substituted per tenant, so adding a company
# is one line rather than a copied connection string with one word changed.
#
# TENANT_CATALOGUE_PATH=/etc/munaxa/tenants.json
# TENANT_CATALOGUE={"defaults":{"databaseUrlTemplate":"postgresql://edms_app:…@db/edms_{slug}","migrationUrlTemplate":"postgresql://edms_owner:…@db/edms_{slug}","storage":{"driver":"S3","container":"munaxa-docs","prefixTemplate":"tenants/{slug}"},"search":{"indexTemplate":"docs-{slug}"}},"tenants":[{"id":"…","slug":"acme"}]}

# The application role. It has no BYPASSRLS; migrations use DATABASE_MIGRATION_URL.
# Under a catalogue these are the fallback for a tenant that states no database of its own.
DATABASE_URL=postgresql://edms_app:local-development-only@localhost:5433/edms
DATABASE_MIGRATION_URL=postgresql://edms_owner:local-development-only@localhost:5433/edms
# Per tenant, not per process: the connection ceiling is this times DATABASE_MAX_TENANT_CLIENTS,
# and PostgreSQL's max_connections is what it has to fit inside.
DATABASE_POOL_SIZE=10
# How many tenant databases one process holds connections to at once. The least recently used is
# disconnected beyond this, which costs a reconnect and never costs a single-tenant install
# anything.
DATABASE_MAX_TENANT_CLIENTS=25

REDIS_URL=redis://localhost:6380

# At least 32 characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# NONE means "not configured": the port is bound to an adapter that fails naming the variable
# that would fix it. Production refuses to start with NONE (configuration.ts).
#
# The bucket, container or root directory. Each company's bytes live under its own prefix inside
# it, added and checked by the storage port itself — so a shared bucket and a bucket per company
# are the same code path.
#
# LOCAL is allowed in on-premise production and refused in cloud production: a filesystem is not
# shared between instances, so a document uploaded through one would be missing from the next.
#
# Two drivers exist as of Phase 3. `S3` and `R2` are the same adapter: they differ in endpoint,
# region and addressing style, which is configuration.
#
#   LOCAL   the filesystem, for a single-server installation. The API serves the bytes itself,
#           through two streaming endpoints authorised by a signed capability — see
#           docs/architecture/11-storage-architecture.md §2.
#   S3/R2   presigned URLs, browser straight to the store. AWS, MinIO, Cloudflare R2.
STORAGE_DRIVER=NONE
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
# Both halves of the pair, or neither — a deployment on an instance role supplies neither, and
# supplying exactly one is the misconfiguration boot validation refuses.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_SESSION_TOKEN=
# MinIO and most self-hosted stores put the bucket in the path; AWS and R2 put it in the hostname.
STORAGE_FORCE_PATH_STYLE=false
# LOCAL only: where files are written. Each company's prefix is a directory inside it.
STORAGE_LOCAL_ROOT=./.storage
# LOCAL only: where a browser reaches the API's own transfer endpoints. The API cannot infer this
# from the socket it listens on when it sits behind a reverse proxy.
STORAGE_PUBLIC_URL=http://localhost:3001
# How long a presigned upload or download URL lives, and the ceiling on any one file.
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_MAX_UPLOAD_BYTES=2147483648
#
# The local stack in infra/docker-compose.yml runs MinIO for exactly this. To use it:
#   STORAGE_DRIVER=S3
#   STORAGE_BUCKET=munaxa-docs
#   STORAGE_ENDPOINT=http://localhost:9000
#   STORAGE_FORCE_PATH_STYLE=true
#   STORAGE_ACCESS_KEY_ID=edms-local
#   STORAGE_SECRET_ACCESS_KEY=local-development-only
SEARCH_DRIVER=POSTGRES
OCR_DRIVER=NONE
MAIL_DRIVER=NONE
AV_DRIVER=NONE

OPENAPI_ENABLED=true

# The web app
NEXT_PUBLIC_API_URL=http://localhost:3001
