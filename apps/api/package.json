{
  "name": "@edms/api",
  "version": "0.1.0",
  "private": true,
  "description": "Munaxa Docs API \u2014 NestJS modular monolith. Every business rule, every permission decision, every audit write.",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/main.js",
    "provision": "node dist/provision.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prisma:generate": "prisma generate --schema ../../prisma/schema.prisma"
  },
  "dependencies": {
    "@edms/contracts": "workspace:*",
    "@edms/domain": "workspace:*",
    "@edms/i18n": "workspace:*",
    "@edms/utils": "workspace:*",
    "@munaxa/auth": "^2.1.0",
    "@munaxa/cache": "^2.1.0",
    "@munaxa/crypto": "^2.1.0",
    "@munaxa/interfaces": "^2.1.0",
    "@munaxa/logging": "^2.1.0",
    "@munaxa/rbac": "^2.1.0",
    "@munaxa/session": "^2.1.0",
    "@munaxa/types": "^2.1.0",
    "@nestjs/common": "^11.0.6",
    "@nestjs/core": "^11.0.6",
    "@nestjs/platform-express": "^11.0.6",
    "@nestjs/swagger": "^11.0.3",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.19.3",
    "bullmq": "^5.34.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@munaxa/config-eslint": "^1.0.0",
    "@munaxa/config-typescript": "^1.0.0",
    "@munaxa/conformance": "^2.1.0",
    "@nestjs/testing": "^11.0.6",
    "@swc/core": "^1.10.9",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "prisma": "^6.19.3",
    "typescript": "^5.7.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.0.5"
  }
}
