{
  "name": "@edms/web",
  "version": "0.1.0",
  "private": true,
  "description": "Munaxa Docs web workspace \u2014 Next.js 15 App Router, consuming the shared platform with the docs theme.",
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "munaxa-sync-brand docs public",
    "build": "next build",
    "predev": "munaxa-sync-brand docs public",
    "sync:brand": "munaxa-sync-brand docs public",
    "verify:styles": "node scripts/verify-platform-styles.mjs",
    "typegen": "next typegen",
    "dev": "next dev --port 3000",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project=logic --project=a11y",
    "test:visual": "vitest run --project=browser",
    "test:e2e": "vitest run --project=e2e"
  },
  "dependencies": {
    "@edms/contracts": "workspace:*",
    "@edms/domain": "workspace:*",
    "@edms/i18n": "workspace:*",
    "@edms/utils": "workspace:*",
    "@munaxa/icons": "^1.1.1",
    "@munaxa/platform": "^1.6.1",
    "@munaxa/theme": "^1.1.1",
    "@munaxa/tokens": "^1.1.1",
    "@munaxa/ui": "^1.1.1",
    "@tanstack/react-query": "^5.64.1",
    "next": "^15.1.6",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@munaxa/config-eslint": "^1.0.0",
    "@munaxa/config-typescript": "^1.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.10.7",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.18.0",
    "jsdom": "^30.0.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
