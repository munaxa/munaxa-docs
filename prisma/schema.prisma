// Munaxa Docs — database foundation.
//
// Phase 0.5 models only what is cross-cutting and true of every future table: the tenant
// itself, the append-only audit trail, the transactional outbox and idempotency keys.
// Documents, revisions, workflows, libraries and configuration arrive with the phases that
// own them (`docs/architecture/05-database-design.md` is the target design).
//
// The conventions below are the contract every later model follows:
//
//   id            uuid, v7, generated by the application — time-ordered, so index locality
//                 survives without exposing a guessable sequence
//   tenant_id     on every business table; the only exception is `tenant` itself
//   created_at / updated_at         timestamptz, UTC
//   created_by / updated_by         the acting user; never inferred at read time
//   deleted_at / deleted_by         soft delete — NULL means live
//   version       optimistic locking on every aggregate root
//   naming        snake_case, singular table names, ix_/uq_/fk_/ck_ prefixes
//
// Every unique constraint on soft-deletable data is partial (`WHERE deleted_at IS NULL`), so
// a deleted row never blocks a new one. The one deliberate exception is a document's number,
// which stays reserved forever precisely so it can never be re-issued.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CLOSED

  @@map("tenant_status")
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILED

  @@map("audit_outcome")
}

enum AuditSubjectType {
  DOCUMENT
  REVISION
  FOLDER
  LIBRARY
  USER
  ROLE
  WORKFLOW
  TASK
  CONFIGURATION
  SESSION
  FILE
  SEARCH
  EXPORT
  /// A delegation — Phase 11's addition, and for the same reason `EXPORT` was Phase 9's: it is not
  /// a `USER`. A delegation is an arrangement *between* two people, and filing its four actions on
  /// either party's timeline would hide it from the other.
  DELEGATION

  @@map("audit_subject_type")
}

/// Where an evidence bundle has got to (`13-audit-architecture.md` §6).
enum AuditExportState {
  REQUESTED
  RUNNING
  COMPLETED
  FAILED

  @@map("audit_export_state")
}

enum ActorChannel {
  WEB
  API
  WORKER
  SYSTEM

  @@map("actor_channel")
}

/// The customer organisation. The only table without a `tenant_id`, because it *is* the
/// tenant — and therefore the only table not covered by a row-level security policy keyed on
/// `current_setting('app.tenant_id')`.
model Tenant {
  id        String       @id @db.Uuid
  slug      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  /// Locale, timezone, branding and security policy. `jsonb` because the shape is genuinely
  /// tenant-defined — never as a way to avoid modelling something the product knows about.
  settings  Json         @default("{}")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?    @map("deleted_at") @db.Timestamptz(6)

  auditEvents              AuditEvent[]
  outbox                   OutboxMessage[]
  idempotency              IdempotencyKey[]
  users                    User[]
  roles                    Role[]
  sessions                 SessionFamily[]
  notificationTemplates    NotificationTemplate[]
  notifications            NotificationMessage[]
  notificationSuppressions NotificationSuppression[]
  notificationBatches      NotificationBatch[]
  companies                Company[]
  entities                 Entity[]
  branches                 Branch[]
  departments              Department[]
  confidentialityLevels    ConfidentialityLevel[]
  retentionPolicies        RetentionPolicy[]
  numberingRules           NumberingRule[]
  numberSequences          NumberSequence[]
  numberReservations       NumberReservation[]
  categories               Category[]
  metadataFields           MetadataField[]
  documentTypes            DocumentType[]
  libraries                Library[]
  folders                  Folder[]
  workflowDefinitions      WorkflowDefinition[]
  workflowVersions         WorkflowVersion[]
  fileObjects              FileObject[]
  uploadSessions           UploadSession[]
  documents                Document[]
  documentRevisions        DocumentRevision[]
  previewArtifacts         PreviewArtifact[]
  previewRenders           PreviewRender[]
  ocrResults               OcrResult[]
  workflowInstances        WorkflowInstance[]
  workflowStages           WorkflowStage[]
  approvalTasks            ApprovalTask[]
  workflowComments         WorkflowComment[]
  workflowTimers           WorkflowTimer[]
  approvalGroups           ApprovalGroup[]
  workingCalendars         WorkingCalendar[]
  documentLocks            DocumentLock[]
  savedSearches            SavedSearch[]
  recentSearches           RecentSearch[]
  searchRebuilds           SearchRebuild[]
  auditExports             AuditExport[]
  retentionSchedules       RetentionSchedule[]
  legalHolds               LegalHold[]
  documentTombstones       DocumentTombstone[]
  delegations              Delegation[]

  @@index([status], map: "ix_tenant_status")
  @@map("tenant")
}

/// Append-only and hash-chained.
///
/// Each row's `hash` covers `previous_hash`, so removing or editing any event breaks every
/// digest after it. The application role is granted `INSERT` and `SELECT` only — no `UPDATE`,
/// no `DELETE` — and a database trigger rejects both regardless of grants
/// (`infra/sql/02-audit-immutability.sql`).
///
/// Audit outlives its subject: it is never soft-deleted, and a purged document leaves its
/// trail behind. There is deliberately no `deleted_at` on this model.
model AuditEvent {
  id               String           @id @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  /// Per-tenant, monotonic and **gap-free** (`13-audit-architecture.md` §3).
  ///
  /// The hash chain proves that no record was altered, but on its own it cannot prove that
  /// none was removed from the end: truncate the last k events and what remains still chains
  /// perfectly. A contiguous sequence is what makes a hole visible, and it is why this is
  /// allocated as `max + 1` under a per-tenant advisory lock rather than from a PostgreSQL
  /// sequence — those gap on rollback, and a gap is indistinguishable from a deletion.
  sequence         BigInt
  occurredAt       DateTime         @map("occurred_at") @db.Timestamptz(6)
  /// Null when the system acted alone — a retention purge, a scheduled verification.
  actorId          String?          @map("actor_id") @db.Uuid
  /// Recorded when the actor was acting under a delegation. Both people are in the trail.
  onBehalfOfId     String?          @map("on_behalf_of_id") @db.Uuid
  channel          ActorChannel
  action           String
  subjectType      AuditSubjectType @map("subject_type")
  subjectId        String           @map("subject_id") @db.Uuid
  outcome          AuditOutcome
  /// Minimised: enough to reconstruct what happened, never a document's content and never a
  /// personal identifier that is not already in the subject.
  payload          Json             @default("{}")
  /// Required where a confidentiality level or policy demands a stated reason for access.
  reason           String?
  correlationId    String           @map("correlation_id")
  ipAddress        String?          @map("ip_address")
  userAgent        String?          @map("user_agent")
  hash             String           @db.Char(64)
  previousHash     String           @map("previous_hash") @db.Char(64)
  /// Which field set this row's digest covers (`core/audit/hash-chain.ts`).
  ///
  /// `1` is Phase 1's nine fields; `2` adds `sequence`, `channel`, `on_behalf_of_id`, `reason`,
  /// `correlation_id`, `ip_address` and `user_agent`. Stamped per row rather than assumed per
  /// deployment because rows written under the older digest cannot be rehashed — the table
  /// refuses `UPDATE` to every role, owner included, which is precisely the property that makes
  /// the trail worth having. Verification dispatches on this, and an evidence bundle's manifest
  /// reports it, so a bundle never claims to attest a field the digest did not cover.
  chainHashVersion Int              @default(1) @map("chain_hash_version") @db.SmallInt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// The chain's order, and the constraint that makes a duplicate sequence impossible even if
  /// two writers somehow bypass the advisory lock.
  @@unique([tenantId, sequence], map: "uq_audit_tenant_sequence")
  /// The document timeline and the subject-scoped audit tab.
  @@index([tenantId, subjectType, subjectId, occurredAt(sort: Desc)], map: "ix_audit_subject")
  /// "What did this person do", for an investigation.
  @@index([tenantId, actorId, occurredAt(sort: Desc)], map: "ix_audit_actor")
  /// Chain verification walks in occurrence order; also the partition key when the table is
  /// range-partitioned by month.
  @@index([tenantId, occurredAt], map: "ix_audit_occurred")
  /// Ties an event back to the request that produced it, across API, worker and logs.
  @@index([correlationId], map: "ix_audit_correlation")
  /// The audit search of §6 filters by action first — "every ACCESS_DENIED last quarter" is the
  /// question it exists to answer, and without this it is a sequential scan of the trail.
  @@index([tenantId, action, occurredAt(sort: Desc)], map: "ix_audit_action")
  @@map("audit_event")
}

/// An evidence bundle (`13-audit-architecture.md` §6).
///
/// The row is the request and its outcome; the bundle itself is a set of objects in storage,
/// listed in `artefacts` with the digest of each. It is deliberately *not* audit data — it is a
/// job, it is mutable, and it is soft-deletable by retention like any other derived artefact.
/// What is immutable is the trail it was made from, and the manifest's signature is what ties
/// this row to that.
model AuditExport {
  id            String           @id @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  state         AuditExportState @default(REQUESTED)
  /// The range the bundle covers, and the filters narrowing it. Both are in the manifest too.
  fromDate      DateTime         @map("from_date") @db.Timestamptz(6)
  toDate        DateTime         @map("to_date") @db.Timestamptz(6)
  filters       Json             @default("{}")
  /// Who asked. Never null: an export is always somebody's act, never the system's.
  requestedById String           @map("requested_by_id") @db.Uuid
  requestedAt   DateTime         @map("requested_at") @db.Timestamptz(6)
  eventCount    Int              @default(0) @map("event_count")
  /// The storage prefix the bundle's objects live under, and what they are.
  storagePrefix String?          @map("storage_prefix")
  artefacts     Json             @default("[]")
  /// The verification the bundle carries: whether the range chained, and where it did not.
  chainIntact   Boolean?         @map("chain_intact")
  brokenAtId    String?          @map("broken_at_id") @db.Uuid
  completedAt   DateTime?        @map("completed_at") @db.Timestamptz(6)
  /// Operator-readable, set exactly when the state is FAILED.
  error         String?
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?          @map("created_by") @db.Uuid
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?          @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, requestedAt(sort: Desc)], map: "ix_audit_export_tenant")
  @@map("audit_export")
}

/// The transactional outbox.
///
/// A use case writes a row here inside its own transaction; the dispatcher claims unsent rows
/// with `FOR UPDATE SKIP LOCKED` after commit and enqueues them. Nothing is published to a
/// queue inside a transaction
/// (`docs/architecture/adr/0011-transactional-outbox-for-async-work.md`).
model OutboxMessage {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type")
  /// Payload contract version. A shipped shape never changes; a different shape is a new
  /// version, and consumers keep handling the old one until nothing emits it.
  eventVersion  Int       @default(1) @map("event_version")
  payload       Json
  correlationId String    @map("correlation_id")
  /// Lets an event be published now and delivered later — a reminder, a deferred digest.
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// The dispatcher's only query: unprocessed rows that are due. Partial, so the index stays
  /// small even though the table holds every event ever published for the last seven days.
  @@index([availableAt], map: "ix_outbox_pending")
  @@index([aggregateType, aggregateId], map: "ix_outbox_aggregate")
  @@map("outbox_message")
}

/// Stored responses for replayed mutating requests.
///
/// A client cannot tell a lost response from a lost request, so a retry is normal rather than
/// exotic. Keyed by `(tenant_id, key)`: one tenant's key can never replay into another's
/// (`docs/architecture/15-api-architecture.md` §2).
model IdempotencyKey {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  key           String
  /// Method and path, so the same key on a different endpoint is a client bug, not a replay.
  requestPath   String   @map("request_path")
  requestMethod String   @map("request_method")
  /// Fingerprint of the request body; a reused key with different content is rejected rather
  /// than answered with someone else's result.
  requestHash   String   @map("request_hash") @db.Char(64)
  statusCode    Int      @map("status_code")
  responseBody  Json     @map("response_body")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key], map: "uq_idempotency_tenant_key")
  @@index([expiresAt], map: "ix_idempotency_expiry")
  @@map("idempotency_key")
}

// ---------------------------------------------------------------------------------------
// Identity — Phase 1.
//
// Users, roles, the role→permission matrix and refresh-token sessions. Object-level reach
// (which folder, which library) is not here: it is resolved per request against the scope
// tree by the ACL resolver, so revoking access takes effect on the next call rather than at
// the next token refresh (`docs/architecture/08-permission-model.md` §3).
// ---------------------------------------------------------------------------------------

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED

  @@map("user_status")
}

/// How a stored password was derived. Recorded per row so the parameters can be raised
/// without invalidating every existing credential: a user whose row names an older algorithm
/// is transparently re-hashed on their next successful sign-in.
enum PasswordAlgorithm {
  SCRYPT

  @@map("password_algorithm")
}

/// A person who can sign in.
///
/// `emailNormalized` is the lookup key and the uniqueness key; `email` preserves what the
/// user typed. The unique index is partial on `deleted_at IS NULL`, so deleting a user frees
/// their address for re-invitation — the general rule for soft-deletable data.
model User {
  id                String             @id @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  email             String
  /// Lower-cased and trimmed. Never shown; only matched against.
  emailNormalized   String             @map("email_normalized")
  displayName       String             @map("display_name")
  status            UserStatus         @default(INVITED)
  /// Null for an invited user who has not yet set one, and for a user who authenticates
  /// through a federated issuer. Absence is never a reason to allow a sign-in.
  passwordHash      String?            @map("password_hash")
  passwordAlgorithm PasswordAlgorithm? @map("password_algorithm")
  passwordUpdatedAt DateTime?          @map("password_updated_at") @db.Timestamptz(6)
  mfaEnrolled       Boolean            @default(false) @map("mfa_enrolled")
  /// Bumped whenever this user's roles or permissions change. An access token carrying an
  /// older value is refused, so a revoked role takes effect within one request rather than
  /// at the end of the token's lifetime.
  permissionVersion Int                @default(1) @map("permission_version")
  lastLoginAt       DateTime?          @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String?            @map("created_by") @db.Uuid
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy         String?            @map("updated_by") @db.Uuid
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz(6)
  deletedBy         String?            @map("deleted_by") @db.Uuid
  /// Optimistic locking. Two administrators editing the same user do not silently overwrite.
  version           Int                @default(1)

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roles                   UserRole[]
  sessions                SessionFamily[]
  notificationPreferences NotificationPreference[]
  notificationQuietHours  NotificationQuietHours?
  notifications           NotificationMessage[]
  departments             UserDepartment[]
  favorites               DocumentFavorite[]
  documentViews           DocumentView[]
  approvalTasks           ApprovalTask[]           @relation("TaskAssignee")
  workflowComments        WorkflowComment[]
  approvalGroups          ApprovalGroupMember[]
  documentLocks           DocumentLock[]
  savedSearches           SavedSearch[]
  recentSearches          RecentSearch[]
  delegationsGiven        Delegation[]             @relation("DelegationDelegator")
  delegationsReceived     Delegation[]             @relation("DelegationDelegate")

  @@index([tenantId, emailNormalized], map: "ix_user_email")
  @@index([tenantId, status], map: "ix_user_status")
  @@map("user")
}

/// A named bundle of permissions.
///
/// The eight `SystemRole` keys are seeded into every tenant and cannot be renamed or deleted,
/// because the product refers to them by key. Their *permissions* are tenant data and may be
/// edited — a tenant whose approvers must also publish should not need a release.
model Role {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  key         String
  name        String
  description String?
  /// Seeded by the product. Blocks deletion and renaming of the key, not of the permissions.
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy   String?   @map("deleted_by") @db.Uuid
  version     Int       @default(1)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  users       UserRole[]

  @@index([tenantId], map: "ix_role_tenant")
  @@map("role")
}

/// One permission granted to one role.
///
/// A row per grant rather than an array column, so revoking a single permission is a delete
/// and the matrix is queryable — "which roles can approve" is a question the product asks.
/// `permission` is validated against the catalogue in `@edms/domain` before it is written;
/// the database deliberately does not carry an enum of them, because adding a permission
/// would then require a migration in lockstep with the code that uses it.
model RolePermission {
  tenantId   String @map("tenant_id") @db.Uuid
  roleId     String @map("role_id") @db.Uuid
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@index([tenantId, permission], map: "ix_role_permission_lookup")
  @@map("role_permission")
}

/// A role held by a user.
model UserRole {
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedBy String?  @map("assigned_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([tenantId, roleId], map: "ix_user_role_by_role")
  @@map("user_role")
}

/// One sign-in, and the chain of refresh tokens it issued.
///
/// The family is the unit of revocation. Refresh tokens rotate: each use issues a successor
/// and marks its predecessor used. Presenting an already-used token means the token was
/// stolen — either the thief or the legitimate holder is replaying it, and there is no way to
/// tell which — so the whole family is revoked and both parties must sign in again
/// (`docs/architecture/17-security-architecture.md` §2).
model SessionFamily {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Set when the family is revoked: by sign-out, by password change, or by token reuse.
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?   @map("revoked_reason")
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens RefreshToken[]

  @@index([tenantId, userId], map: "ix_session_family_user")
  @@map("session_family")
}

/// A single refresh token, stored only as a hash.
///
/// The plaintext exists in the client's cookie and nowhere else: a database disclosure must
/// not hand over live sessions. Lookup is by hash, which is why the hash is unique.
model RefreshToken {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.Char(64)
  issuedAt  DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Set the moment the token is exchanged. A second exchange is reuse, and kills the family.
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  family SessionFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([tokenHash], map: "uq_refresh_token_hash")
  @@index([familyId], map: "ix_refresh_token_family")
  @@index([expiresAt], map: "ix_refresh_token_expiry")
  @@map("refresh_token")
}

// ---------------------------------------------------------------------------------------
// Notification — Phase 1.
//
// The framework: what was sent, to whom, on which channel, and what each person asked for.
// Templates ship with the product (`modules/notification/domain/default-templates.ts`); rows
// here are tenant *overrides*, so a tenant that has customised nothing still gets correct,
// translated notifications (`docs/architecture/18-notification-architecture.md` §6).
// ---------------------------------------------------------------------------------------

enum NotificationChannel {
  EMAIL
  IN_APP
  SMS
  PUSH
  WEBHOOK

  @@map("notification_channel")
}

enum DeliveryState {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SUPPRESSED
  /// Waiting for a window to open — quiet hours, or the digest it will be rolled into (§5).
  HELD
  /// Went out inside a summary rather than on its own; never delivered individually.
  DIGESTED

  @@map("delivery_state")
}

enum DigestFrequency {
  IMMEDIATE
  HOURLY
  DAILY
  WEEKLY

  @@map("digest_frequency")
}

/// A tenant's override of a shipped template.
///
/// Absence means "use the product's". That is why there is no seeding step: an empty table is
/// a fully working tenant, and a row exists only where somebody deliberately changed something.
model NotificationTemplate {
  id        String              @id @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  /// The notification type key, e.g. `security.session.revoked`.
  typeKey   String              @map("type_key")
  channel   NotificationChannel
  locale    String
  subject   String
  bodyText  String              @map("body_text")
  /// Null for channels with no HTML — in-app, SMS.
  bodyHtml  String?             @map("body_html")
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?             @map("created_by") @db.Uuid
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?             @map("updated_by") @db.Uuid
  version   Int                 @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, typeKey, channel, locale], map: "uq_notification_template")
  @@map("notification_template")
}

/// What one person asked to receive, and how often.
///
/// A missing row means "no opinion", never "off": the type's own defaults apply, and a
/// mandatory type is delivered regardless (§5).
model NotificationPreference {
  tenantId  String                @map("tenant_id") @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  typeKey   String                @map("type_key")
  channels  NotificationChannel[]
  digest    DigestFrequency       @default(IMMEDIATE)
  updatedAt DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, typeKey])
  @@index([tenantId, typeKey], map: "ix_notification_preference_type")
  @@map("notification_preference")
}

/// One person's quiet hours — 18 §5's "quiet hours with a timezone, during which non-urgent
/// notifications are held and released afterwards".
///
/// Its own table rather than columns on `notification_preference`, because that table is keyed
/// by `(user, type)` and quiet hours are a property of the *person*. Storing them per type would
/// invite a user to be quiet for approvals and loud for publications at three in the morning,
/// which is not a preference anybody has.
///
/// The window is minutes past local midnight, not two timestamps: "do not write to me between
/// 19:00 and 07:00" is a rule about a clock face, and instants would expire. A start after the
/// end wraps midnight, which is the ordinary case rather than a special one.
model NotificationQuietHours {
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String   @id @map("user_id") @db.Uuid
  startMinute Int      @map("start_minute")
  endMinute   Int      @map("end_minute")
  /// An IANA zone. Validated by the API against `Intl`, which is the only list that matters.
  timezone    String
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "ix_notification_quiet_hours_tenant")
  @@map("notification_quiet_hours")
}

/// An address this tenant has stopped writing to — 18 §7's "repeated hard bounces suppress the
/// address and alert an administrator".
///
/// Keyed by the **address**, not the user. Identity owns users and nobody reads its tables, but
/// the stronger reason is that suppression is a fact about a mailbox: somebody who corrects
/// their address is reachable again at once, and somebody who inherits a colleague's old address
/// does not inherit their bounces.
///
/// `bounce_count` accumulates and `suppressed_at` is set only when it crosses the tenant's
/// threshold, so one provider misclassifying a transient condition as permanent does not cut a
/// person off from every notification in the product.
model NotificationSuppression {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  /// Lower-cased at the application boundary; mail addresses are matched case-insensitively.
  address       String
  bounceCount   Int       @default(0) @map("bounce_count")
  /// Null while the address is merely accumulating failures. Set once it is refused.
  suppressedAt  DateTime? @map("suppressed_at") @db.Timestamptz(6)
  lastReason    String?   @map("last_reason")
  lastBouncedAt DateTime? @map("last_bounced_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, address], map: "uq_notification_suppression")
  @@index([tenantId, suppressedAt], map: "ix_notification_suppression_active")
  @@map("notification_suppression")
}

/// One open coalescing window — 18 §7's "bulk operations emit **one summary notification**,
/// never one per object".
///
/// A row rather than a delayed job whose id encodes the batch. The queue would coalesce too, and
/// would keep the *first* payload and discard the rest — so the summary would say "1" however
/// many objects the operation touched. A row that increments is the only shape that can count.
///
/// The window's end is set when it opens and never extended, so a sweep that runs for an hour
/// produces one summary at the window mark and another for the remainder, rather than a window
/// that never closes because objects keep arriving.
model NotificationBatch {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// What is being coalesced — a cascade identifier, or a sweep and the day it ran.
  key          String
  typeKey      String   @map("type_key")
  /// Who the one summary goes to. Resolved when the window opens and unioned as it grows.
  recipientIds String[] @map("recipient_ids") @db.Uuid
  itemCount    Int      @default(0) @map("item_count")
  /// Placeholder values the summary renders with, beyond the count.
  values       Json     @default("{}")
  releaseAt    DateTime @map("release_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, key], map: "uq_notification_batch")
  @@index([tenantId, releaseAt], map: "ix_notification_batch_due")
  @@map("notification_batch")
}

/// One notification, to one person, on one channel.
///
/// The rendered subject and body are stored rather than re-rendered at delivery: what was sent
/// is a fact, and a template edited afterwards must not change what the record says was sent.
///
/// In-app delivery *is* this row — there is no adapter, which is why a mail provider outage
/// never affects it (§7).
model NotificationMessage {
  id              String              @id @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  recipientId     String              @map("recipient_id") @db.Uuid
  typeKey         String              @map("type_key")
  channel         NotificationChannel
  locale          String
  /// The channel address this went to, captured when the message was created.
  ///
  /// Stored rather than looked up at delivery: what was sent, and where, is a fact. A person
  /// who changes their email afterwards must not retroactively change the record of what was
  /// already sent to the old one.
  address         String
  subject         String
  bodyText        String              @map("body_text")
  bodyHtml        String?             @map("body_html")
  state           DeliveryState       @default(QUEUED)
  attempts        Int                 @default(0)
  /// Deterministic per (event, recipient, channel). A second delivery attempt for the same
  /// key is a no-op rather than a duplicate in somebody's inbox (§7).
  idempotencyKey  String              @map("idempotency_key")
  failureReason   String?             @map("failure_reason")
  sentAt          DateTime?           @map("sent_at") @db.Timestamptz(6)
  readAt          DateTime?           @map("read_at") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  /// When a held message may go out — quiet hours' end, or its digest window's (Phase 12).
  ///
  /// It gates the delivery claim as well as explaining the state: a row whose `release_at` is in
  /// the future is not claimable, which is what makes a quiet-hours hold survive a restart with
  /// no scheduler state of its own.
  releaseAt       DateTime?           @map("release_at") @db.Timestamptz(6)
  /// The digest window this message is waiting for, or null when it is not waiting for one.
  ///
  /// Stored on the row rather than re-read from the preference at collection time, because the
  /// two answers differ the moment somebody changes their mind mid-window — and the honest one
  /// is the choice that was in force when the message was held. It is also what lets the
  /// quiet-hours release and the digest collection be two plain queries over the same state
  /// instead of one correlated against `notification_preference` per row.
  digestWindow    DigestFrequency?    @map("digest_window")
  /// The digest that carried this message, once one collected it.
  ///
  /// A self-relation rather than a flag, so "what was in Tuesday's digest" is a query rather
  /// than an inference from timestamps.
  digestMessageId String?             @map("digest_message_id") @db.Uuid

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recipient User                  @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  digest    NotificationMessage?  @relation("NotificationDigestMembers", fields: [digestMessageId], references: [id], onDelete: SetNull)
  digested  NotificationMessage[] @relation("NotificationDigestMembers")

  @@unique([tenantId, idempotencyKey], map: "uq_notification_idempotency")
  /// The inbox query: one person's unread, newest first.
  @@index([tenantId, recipientId, readAt, createdAt(sort: Desc)], map: "ix_notification_inbox")
  /// The dispatcher's claim query, and the release sweep's — both filter on `release_at`.
  @@index([tenantId, state, releaseAt, createdAt], map: "ix_notification_pending")
  @@map("notification_message")
}

// ---------------------------------------------------------------------------------------
// Organisation — Phase 1.
//
// The scope tree: TENANT → COMPANY → ENTITY → DEPARTMENT (nesting), which is the chain the
// ACL resolver walks (`packages/domain/src/scope.ts`, `08-permission-model.md` §3).
//
// `branch` is deliberately **not** a level of that chain. It is a location — its code appears
// in document numbers and a department may sit at one — but permission does not flow through
// it. Adding it to the chain would give every ACL an extra level nobody grants on.
// ---------------------------------------------------------------------------------------

/// The top of a tenant's tree. Most tenants have one; a group with separate legal books has
/// several, which is why this is a table and not a column on `tenant`.
model Company {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  code      String
  name      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  version   Int       @default(1)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entities Entity[]

  @@index([tenantId], map: "ix_company_tenant")
  @@map("company")
}

/// A legal entity within a company. Owns branches and departments.
model Entity {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  code      String
  name      String
  legalName String?   @map("legal_name")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  version   Int       @default(1)

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branches    Branch[]
  departments Department[]
  calendars   WorkingCalendar[]

  @@index([tenantId, companyId], map: "ix_entity_company")
  @@map("entity")
}

/// A physical location. Its code appears in document numbers, which is why it is modelled
/// rather than left as an address string on a department.
model Branch {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  entityId  String    @map("entity_id") @db.Uuid
  code      String
  name      String
  address   String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  version   Int       @default(1)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entity      Entity       @relation(fields: [entityId], references: [id], onDelete: Restrict)
  departments Department[]

  @@index([tenantId, entityId], map: "ix_branch_entity")
  @@map("branch")
}

/// A department, which may nest inside another department.
///
/// `path` materialises the ancestry so resolving an ACL is one indexed query rather than a
/// recursive CTE on every request (`05-database-design.md` §8). It is derived data, maintained
/// by the application whenever a department is created or moved, and it is stored as `text`
/// rather than `ltree` — see ADR-0014 for why, and for what that costs.
model Department {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  entityId  String    @map("entity_id") @db.Uuid
  /// Null for a department that is not tied to a location.
  branchId  String?   @map("branch_id") @db.Uuid
  /// Null for a department directly under the entity.
  parentId  String?   @map("parent_id") @db.Uuid
  code      String
  name      String
  /// Dot-separated ancestor identifiers, this department last. Never written by hand.
  path      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  version   Int       @default(1)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entity   Entity           @relation(fields: [entityId], references: [id], onDelete: Restrict)
  branch   Branch?          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  parent   Department?      @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Department[]     @relation("DepartmentTree")
  members  UserDepartment[]

  @@index([tenantId, entityId], map: "ix_department_entity")
  /// The subtree query: every descendant of a node, by prefix.
  @@index([tenantId, path], map: "ix_department_path")
  @@map("department")
}

/// Which departments a person belongs to.
///
/// One is primary, and it drives routing and numbering defaults — which is why it is a flag
/// here rather than a separate column on the user: a person can move between departments
/// without rewriting their record.
model UserDepartment {
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  isPrimary    Boolean  @default(false) @map("is_primary")
  /// Whether this person manages the department rather than merely belonging to it.
  ///
  /// Added by Phase 4, because `MANAGER_OF` is a participant resolver
  /// (`docs/architecture/07-workflow-architecture.md` §2) and nothing in the model said who
  /// managed anything. A flag on the membership rather than a column on the department: a
  /// department can have two managers and a person can manage one department while belonging to
  /// three, and both are ordinary.
  isManager    Boolean  @default(false) @map("is_manager")
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedBy   String?  @map("assigned_by") @db.Uuid

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([userId, departmentId])
  @@index([tenantId, departmentId], map: "ix_user_department_by_department")
  @@map("user_department")
}

// ---------------------------------------------------------------------------------------
// Administration — Phase 2.
//
// The configuration a tenant edits instead of waiting for a release: what a document *is*
// (type, category, fields), how sensitive it is, how it is numbered, how long it is kept, and
// who must agree to it (`docs/architecture/03-domain-model.md` §3).
//
// Two shapes recur, and both are load-bearing rather than stylistic:
//
//   Every code and key is unique per tenant through a **partial** index on `lower(...)` — so a
//   code freed by a soft delete is reusable, and "QA" and "qa" are one code to the database as
//   well as to the person who typed it. Prisma cannot express either, so they live in the
//   migration alongside the ones Phase 1 declared the same way.
//
//   Every reference between configuration rows is `onDelete: Restrict`. Configuration is
//   soft-deleted, so a cascade would never fire on the ordinary path and would be a silent
//   data-loss path on the extraordinary one. What stops a delete is the application checking
//   for dependents and saying which; the constraint is there for the case where it did not.
// ---------------------------------------------------------------------------------------

enum RevisionLabelStyle {
  NUMERIC
  ALPHABETIC
  MAJOR_MINOR

  @@map("revision_label_style")
}

enum MetadataDataType {
  TEXT
  LONG_TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
  USER
  DEPARTMENT

  @@map("metadata_data_type")
}

enum RetentionTrigger {
  ON_PUBLISH
  ON_SUPERSEDE
  ON_ARCHIVE
  ON_DELETE

  @@map("retention_trigger")
}

enum Disposition {
  REVIEW
  ARCHIVE
  PURGE
  RETAIN_FOREVER

  @@map("disposition")
}

/// What a number sequence restarts on. A rule carries a set of these, not one.
enum SequenceResetScope {
  NEVER
  YEARLY
  MONTHLY
  PER_COMPANY
  PER_ENTITY
  PER_BRANCH
  PER_DEPARTMENT
  PER_DOCUMENT_TYPE
  PER_CATEGORY

  @@map("sequence_reset_scope")
}

/// The organisation nodes a library may hang from. Deliberately not `BRANCH`: a branch is a
/// location, and permission does not flow through one.
enum LibraryOwnerScope {
  TENANT
  COMPANY
  ENTITY
  DEPARTMENT

  @@map("library_owner_scope")
}

enum WorkflowVersionState {
  DRAFT
  PUBLISHED
  DEPRECATED

  @@map("workflow_version_state")
}

/// An ordered sensitivity level and its handling rules.
///
/// `rank` is the level's identity to the product rather than decoration: workflow conditions
/// compare it, audit-on-read is triggered by it, and "more sensitive than" has to be a total
/// order for those questions to have an answer — hence unique per tenant.
///
/// Every flag here **subtracts only**. A level may forbid download to somebody who holds
/// `document:download`; it can never grant it to somebody who does not
/// (`08-permission-model.md` §4).
model ConfidentialityLevel {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  code          String
  name          String
  description   String?
  rank          Int       @db.SmallInt
  allowDownload Boolean   @default(true) @map("allow_download")
  allowPrint    Boolean   @default(true) @map("allow_print")
  watermark     Boolean   @default(false)
  /// Forces a stated reason, recorded in the audit trail, even for a permitted read.
  requireReason Boolean   @default(false) @map("require_reason")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?   @map("updated_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy     String?   @map("deleted_by") @db.Uuid
  version       Int       @default(1)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  documentTypes DocumentType[]
  documents     Document[]

  @@index([tenantId, rank], map: "ix_confidentiality_rank")
  @@map("confidentiality_level")
}

/// How long a record is kept after an event, and what happens then.
model RetentionPolicy {
  id             String           @id @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  code           String
  name           String
  description    String?
  trigger        RetentionTrigger
  /// Whole months, because that is how record-keeping regimes are written. Zero only for
  /// `RETAIN_FOREVER`, which the application refuses to pair with a period.
  periodMonths   Int              @map("period_months")
  disposition    Disposition
  /// A person must confirm before the disposition runs. Required for irreversible ones.
  reviewRequired Boolean          @default(false) @map("review_required")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?          @map("created_by") @db.Uuid
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?          @map("updated_by") @db.Uuid
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(6)
  deletedBy      String?          @map("deleted_by") @db.Uuid
  version        Int              @default(1)

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  documentTypes DocumentType[]
  documents     Document[]
  schedules     RetentionSchedule[]

  @@index([tenantId], map: "ix_retention_policy_tenant")
  @@map("retention_policy")
}

/// The document-number recipe (`09-numbering-architecture.md` §1).
///
/// `segments` is the one `jsonb` column here that earns it: the shape is an ordered list of
/// discriminated variants a tenant composes, and modelling it as rows would buy a join per
/// number rendered and indexing nobody queries. It is validated against
/// `@edms/contracts` before it is written, and read back through the same schema.
///
/// `resetScope` is a native array of the enum rather than `jsonb`, because it *is* a closed set
/// and the sequence's scope key is built from it — a value outside the enum would produce a key
/// nothing can reproduce.
model NumberingRule {
  id              String               @id @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  key             String
  name            String
  description     String?
  separator       String               @default("-")
  segments        Json
  resetScope      SequenceResetScope[] @map("reset_scope")
  reserveOnSubmit Boolean              @default(true) @map("reserve_on_submit")
  /// Gapless mode: the number is drawn only at approval, so no reservation can be voided.
  strictGapless   Boolean              @default(false) @map("strict_gapless")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?              @map("created_by") @db.Uuid
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy       String?              @map("updated_by") @db.Uuid
  deletedAt       DateTime?            @map("deleted_at") @db.Timestamptz(6)
  deletedBy       String?              @map("deleted_by") @db.Uuid
  version         Int                  @default(1)

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sequences     NumberSequence[]
  reservations  NumberReservation[]
  documentTypes DocumentType[]

  @@index([tenantId], map: "ix_numbering_rule_tenant")
  @@map("numbering_rule")
}

/// One counter, for one rule, in one reset scope.
///
/// Phase 2 creates and lists these; drawing from one is Phase 5's, and the shape is here now
/// because it is what makes a rule's padding immutable: a rule with a live sequence has already
/// issued numbers, and widening the padding would give one of them a second written form.
///
/// `nextValue` starts at 1 and is claimed under a row lock held for microseconds. It is never
/// decremented — not after a rollback, not after a rejection.
model NumberSequence {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  numberingRuleId String   @map("numbering_rule_id") @db.Uuid
  /// The resolved reset scope, e.g. `ENTITY:JO|TYPE:PROC|YEAR:2026`. Built by the application
  /// from the rule's `resetScope`, so two documents in one series compute the same key.
  scopeKey        String   @map("scope_key")
  nextValue       BigInt   @default(1) @map("next_value")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rule   NumberingRule @relation(fields: [numberingRuleId], references: [id], onDelete: Restrict)

  /// Not partial on `deleted_at`: a sequence is never soft-deleted, because a counter that came
  /// back from the recycle bin would re-issue numbers it had already given out.
  @@unique([tenantId, numberingRuleId, scopeKey], map: "uq_number_sequence_scope")
  @@map("number_sequence")
}

/// What became of a value drawn from a sequence, or set aside before one could draw it.
///
/// Every issued value has a row here forever (`09-numbering-architecture.md` §2). `RESERVED` is a
/// pending number a reviewer can refer to; `ASSIGNED` is a document's number; `VOIDED` is a value
/// whose approval was refused, withdrawn or cancelled — retained, never returned to the pool;
/// `HELD` is a value a controller set aside for an offline process, which the automatic path can
/// never draw because the sequence has already moved past it.
///
/// The formatted text is stored, not recomputed: the rule may change afterwards, and a re-render
/// of an issued number is a bug rather than a feature (§1). `uq (tenant_id, formatted)` is the
/// second half of the never-reused guarantee — `uq (tenant_id, document_number)` on `document` is
/// the first — and like the sequence, a reservation is never soft-deleted.
model NumberReservation {
  id                 String                 @id @db.Uuid
  tenantId           String                 @map("tenant_id") @db.Uuid
  numberingRuleId    String                 @map("numbering_rule_id") @db.Uuid
  /// The series the value was drawn from, exactly as `number_sequence.scope_key` spells it.
  scopeKey           String                 @map("scope_key")
  sequenceValue      BigInt                 @map("sequence_value")
  /// The rendered number, fixed at the moment the value was drawn. Assignment never re-renders
  /// it: the pending reference reviewers held is the number the document receives (§2).
  formatted          String
  state              NumberReservationState @default(RESERVED)
  origin             NumberOrigin           @default(AUTOMATIC)
  /// Null for a `HELD` value nothing has claimed yet; set for everything else.
  documentId         String?                @map("document_id") @db.Uuid
  /// The approval that drew the value. Null for a manual assignment or a held block.
  workflowInstanceId String?                @map("workflow_instance_id") @db.Uuid
  reservedAt         DateTime               @map("reserved_at") @db.Timestamptz(6)
  assignedAt         DateTime?              @map("assigned_at") @db.Timestamptz(6)
  voidedAt           DateTime?              @map("voided_at") @db.Timestamptz(6)
  /// Why a voided value was voided — the workflow outcome or the controller's stated reason.
  voidReason         String?                @map("void_reason")
  /// A controller's note on a held block: which offline process the values were set aside for.
  note               String?
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy          String?                @map("created_by") @db.Uuid
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rule             NumberingRule     @relation(fields: [numberingRuleId], references: [id], onDelete: Restrict)
  document         Document?         @relation(fields: [documentId], references: [id], onDelete: Restrict)
  workflowInstance WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id], onDelete: Restrict)

  /// Reuse made impossible even under a logic bug, deliberately not partial on anything: a
  /// voided value blocks its text as firmly as an assigned one (§2).
  @@unique([tenantId, formatted], map: "uq_number_reservation_formatted")
  @@index([tenantId, documentId], map: "ix_number_reservation_document")
  @@index([tenantId, workflowInstanceId], map: "ix_number_reservation_instance")
  /// The admin screen's listing: a rule's reservations, newest first, filterable by state.
  @@index([tenantId, numberingRuleId, state, reservedAt(sort: Desc)], map: "ix_number_reservation_rule")
  @@map("number_reservation")
}

/// Business classification, hierarchical and cutting across folders.
///
/// `path` materialises the ancestry for the same reason `department.path` does, and is written
/// only by the application, for the whole subtree, inside the transaction that moves a node
/// (ADR-0014).
model Category {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  /// Null for a top-level category.
  parentId    String?   @map("parent_id") @db.Uuid
  code        String
  name        String
  description String?
  /// Dot-separated ancestor identifiers, this category last. Never written by hand.
  path        String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy   String?   @map("deleted_by") @db.Uuid
  version     Int       @default(1)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  documents Document[]

  @@index([tenantId, parentId], map: "ix_category_parent")
  @@index([tenantId, path], map: "ix_category_path")
  @@map("category")
}

/// A tenant-defined field a document type may require.
///
/// `options` and `validation` are `jsonb` because their shape depends on `dataType` — a closed
/// shape per type, validated by `@edms/contracts` on the way in, never free-form. `dataType`
/// itself is immutable once the field exists: the value columns a document stores are typed, so
/// a `TEXT` value has nowhere to go in a `NUMBER` field.
model MetadataField {
  id           String           @id @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  key          String
  name         String
  description  String?
  dataType     MetadataDataType @map("data_type")
  options      Json             @default("[]")
  validation   Json             @default("{}")
  isSearchable Boolean          @default(true) @map("is_searchable")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?          @map("created_by") @db.Uuid
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?          @map("updated_by") @db.Uuid
  deletedAt    DateTime?        @map("deleted_at") @db.Timestamptz(6)
  deletedBy    String?          @map("deleted_by") @db.Uuid
  version      Int              @default(1)

  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  documentTypes  TypeMetadataField[]
  documentValues DocumentMetadataValue[]

  @@index([tenantId], map: "ix_metadata_field_tenant")
  @@map("metadata_field")
}

/// The policy pack for a document: which fields, which approval, which number, how long kept.
///
/// Every reference is to configuration rather than a copy of it, and a document freezes what it
/// needs at creation. That is the split that lets a type be edited without rewriting history:
/// changes apply to documents created afterwards, and documents that already exist keep the
/// policy they were created under.
model DocumentType {
  id                       String             @id @db.Uuid
  tenantId                 String             @map("tenant_id") @db.Uuid
  code                     String
  name                     String
  description              String?
  numberingRuleId          String             @map("numbering_rule_id") @db.Uuid
  /// Null means no approval is required — legitimate for a reference type.
  workflowDefinitionId     String?            @map("workflow_definition_id") @db.Uuid
  retentionPolicyId        String?            @map("retention_policy_id") @db.Uuid
  defaultConfidentialityId String             @map("default_confidentiality_id") @db.Uuid
  revisionLabelStyle       RevisionLabelStyle @default(NUMERIC) @map("revision_label_style")
  /// An inactive type stays attached to existing documents and cannot be chosen for new ones.
  isActive                 Boolean            @default(true) @map("is_active")
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy                String?            @map("created_by") @db.Uuid
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy                String?            @map("updated_by") @db.Uuid
  deletedAt                DateTime?          @map("deleted_at") @db.Timestamptz(6)
  deletedBy                String?            @map("deleted_by") @db.Uuid
  version                  Int                @default(1)

  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  numberingRule      NumberingRule        @relation(fields: [numberingRuleId], references: [id], onDelete: Restrict)
  workflowDefinition WorkflowDefinition?  @relation(fields: [workflowDefinitionId], references: [id], onDelete: Restrict)
  retentionPolicy    RetentionPolicy?     @relation(fields: [retentionPolicyId], references: [id], onDelete: Restrict)
  confidentiality    ConfidentialityLevel @relation(fields: [defaultConfidentialityId], references: [id], onDelete: Restrict)
  fields             TypeMetadataField[]
  documents          Document[]

  @@index([tenantId, isActive], map: "ix_document_type_active")
  @@index([tenantId, workflowDefinitionId], map: "ix_document_type_workflow")
  @@map("document_type")
}

/// A field attached to a type, with the facts the field itself does not carry.
///
/// A join row rather than an array column on either side, so "which types require this field"
/// is an indexed query — which is what a delete has to ask before it refuses.
model TypeMetadataField {
  tenantId        String  @map("tenant_id") @db.Uuid
  documentTypeId  String  @map("document_type_id") @db.Uuid
  metadataFieldId String  @map("metadata_field_id") @db.Uuid
  isRequired      Boolean @default(false) @map("is_required")
  sortOrder       Int     @default(0) @map("sort_order")
  /// Pre-filled on a new document. Stored as text and parsed against the field's own type.
  defaultValue    String? @map("default_value")

  documentType DocumentType  @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  field        MetadataField @relation(fields: [metadataFieldId], references: [id], onDelete: Restrict)

  @@id([documentTypeId, metadataFieldId])
  @@index([tenantId, metadataFieldId], map: "ix_type_field_by_field")
  @@map("type_metadata_field")
}

/// Where documents live, and the tree ACLs are granted on.
///
/// A library belongs to exactly one organisation node, and the pair `(owner_scope_type,
/// owner_scope_id)` says which. It is polymorphic rather than four nullable foreign keys because
/// the alternative is a check constraint counting non-nulls across four columns, and every query
/// then has to coalesce them. The referential integrity a foreign key would give is enforced by
/// the application resolving the node before it writes — and the node types are exactly those
/// the scope chain already walks, so an unresolvable one is a bug the ACL resolver would hit too.
///
/// `owner_scope_id` is null for `TENANT`, and only for `TENANT`: the tenant is implicit, taken
/// from the token, and naming it in a body is what the isolation guard rejects.
model Library {
  id             String            @id @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  code           String
  name           String
  description    String?
  ownerScopeType LibraryOwnerScope @map("owner_scope_type")
  ownerScopeId   String?           @map("owner_scope_id") @db.Uuid
  /// The folder created with the library. Nullable in the schema and never null in practice:
  /// the folder cannot exist before the library it points at, so both are written in one
  /// transaction and this is set in it. A library without one is a failed transaction, and the
  /// repository refuses to map one rather than returning a library nothing can be filed in.
  rootFolderId   String?           @unique(map: "uq_library_root_folder") @map("root_folder_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?           @map("created_by") @db.Uuid
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?           @map("updated_by") @db.Uuid
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz(6)
  deletedBy      String?           @map("deleted_by") @db.Uuid
  version        Int               @default(1)

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rootFolder Folder?  @relation("LibraryRoot", fields: [rootFolderId], references: [id], onDelete: Restrict)
  folders    Folder[] @relation("FolderLibrary")

  @@index([tenantId, ownerScopeType, ownerScopeId], map: "ix_library_owner")
  @@map("library")
}

/// A folder inside a library.
///
/// The tree the ACL resolver walks below a library, materialised the same way departments are.
/// `depth` is stored rather than derived from `path` on every read: the ceiling is checked on
/// every create and move, and counting separators in a string to enforce a limit is the kind of
/// arithmetic that is cheap once and measurable at a thousand folders.
model Folder {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  libraryId       String    @map("library_id") @db.Uuid
  /// Null for the library's root folder, and only for it.
  parentId        String?   @map("parent_id") @db.Uuid
  name            String
  description     String?
  /// Dot-separated ancestor identifiers, this folder last.
  path            String
  depth           Int       @default(1)
  /// False stops the ACL walk here. Administrative permissions are exempt, or a user could
  /// hide a subtree from the administrators accountable for it (`08-permission-model.md` §3).
  inheritAcl      Boolean   @default(true) @map("inherit_acl")
  /// The root cannot be moved, renamed away or deleted; it is the library's own anchor.
  isRoot          Boolean   @default(false) @map("is_root")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?   @map("created_by") @db.Uuid
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy       String?   @map("updated_by") @db.Uuid
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy       String?   @map("deleted_by") @db.Uuid
  /// Which cascade removed this row.
  ///
  /// Deleting a folder soft-deletes its subtree, and restoring must bring back exactly what that
  /// delete took — not everything currently deleted under the node, which would resurrect rows
  /// somebody deleted individually and deliberately beforehand (`05-database-design.md` §4).
  deleteCascadeId String?   @map("delete_cascade_id") @db.Uuid
  version         Int       @default(1)

  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  library       Library    @relation("FolderLibrary", fields: [libraryId], references: [id], onDelete: Restrict)
  parent        Folder?    @relation("FolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      Folder[]   @relation("FolderTree")
  rootOfLibrary Library[]  @relation("LibraryRoot")
  documents     Document[]

  @@index([tenantId, libraryId, parentId], map: "ix_folder_parent")
  @@index([tenantId, path], map: "ix_folder_path")
  @@index([tenantId, deleteCascadeId], map: "ix_folder_cascade")
  @@map("folder")
}

/// A named approval process. Identity only: the rules live in its versions.
model WorkflowDefinition {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  key         String
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy   String?   @map("deleted_by") @db.Uuid
  version     Int       @default(1)

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  versions      WorkflowVersion[]
  documentTypes DocumentType[]
  instances     WorkflowInstance[]

  @@index([tenantId, isActive], map: "ix_workflow_definition_active")
  @@map("workflow_definition")
}

/// One version of a definition — the thing an approval actually binds to.
///
/// **A published version is immutable.** Not by convention: an instance binds to a version, and
/// editing one would change the rules of an approval already running, which
/// `07-workflow-architecture.md` §1 calls the single most important property of the engine.
/// Editing a live workflow therefore means publishing a new version, and retiring one means
/// `DEPRECATED` — which stops new instances and leaves running ones alone.
///
/// There is no `deleted_at`. A version is retired, never removed, because instances keep their
/// version forever and a soft-deleted version would be one a running approval could not read.
model WorkflowVersion {
  id           String               @id @db.Uuid
  tenantId     String               @map("tenant_id") @db.Uuid
  definitionId String               @map("definition_id") @db.Uuid
  /// Monotonic per definition, allocated as `max + 1` in the transaction that creates it.
  version      Int
  state        WorkflowVersionState @default(DRAFT)
  /// Stages, participants, conditions and completion policy — validated against
  /// `@edms/contracts` before it is written, and re-validated on publish.
  definition   Json
  publishedAt  DateTime?            @map("published_at") @db.Timestamptz(6)
  publishedBy  String?              @map("published_by") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?              @map("created_by") @db.Uuid
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?              @map("updated_by") @db.Uuid

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  definitionRecord WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  instances        WorkflowInstance[]

  @@unique([definitionId, version], map: "uq_workflow_version_number")
  @@index([tenantId, definitionId, state], map: "ix_workflow_version_state")
  @@map("workflow_version")
}

// ---------------------------------------------------------------------------------------
// Phase 3 — the document library.
//
//   The first phase whose tables hold a customer's own content rather than their
//   configuration, and the split at the heart of it is ADR-0003: a document's *identity*, the
//   *revision* an approver approved, and the *bytes* are three records with three lifetimes.
//   Collapsing any two of them is the model every document system regrets.
//
//   File metadata and business metadata are likewise separate, and deliberately so. What a
//   file *is* — its digest, its size, its type, its scan verdict — belongs to `file_object`
//   and is a fact about bytes. What a document *means* — its type, its category, its
//   confidentiality, the tenant's own fields — belongs to `document` and
//   `document_metadata_value` and is a fact about the business. A file replaced at the next
//   revision changes every fact in the first group and none in the second.
//
//   Every reference to configuration is `onDelete: Restrict`: a document type in use cannot be
//   removed, and the application says so with a count rather than failing at the constraint.
// ---------------------------------------------------------------------------------------

/// A blob is unreachable until it is CLEAN. Enforced in the use case *and* by a check
/// constraint, in every environment holding real data (`17-security-architecture.md` §5).
enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
  SKIPPED

  @@map("scan_status")
}

enum UploadSessionState {
  OPEN
  COMPLETED
  EXPIRED
  ABORTED

  @@map("upload_session_state")
}

enum DocumentStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  REJECTED
  APPROVED
  PUBLISHED
  CHECKED_OUT
  SUPERSEDED
  ARCHIVED
  EXPIRED
  DELETED
  PURGED

  @@map("document_status")
}

enum RevisionStatus {
  DRAFT
  IN_APPROVAL
  PUBLISHED
  SUPERSEDED
  /// A draft abandoned when its check-out was cancelled or replaced. Retained in history —
  /// its ordinal is spent and never reissued (`10-revision-architecture.md` §3).
  DISCARDED

  @@map("revision_status")
}

/// Why a check-out lock ended. A reason rather than a free-text note, because "who released
/// this lock and why" is a question a compliance report groups by.
enum DocumentLockReleaseReason {
  /// The holder checked a new draft revision in.
  CHECKED_IN
  /// The holder cancelled; any working draft was discarded.
  CANCELLED
  /// Somebody with `document:force-checkin` released another person's lock.
  FORCED
  /// The lock sat past `expires_at` and a later operation swept it aside.
  EXPIRED

  @@map("document_lock_release_reason")
}

/// How the content arrived. Provenance, not behaviour: nothing branches on it, and an auditor
/// asking "was this captured from paper or authored on a machine" has an answer either way.
enum DocumentOrigin {
  UPLOAD
  SCAN

  @@map("document_origin")
}

/// What became of a drawn number (`09-numbering-architecture.md` §2).
enum NumberReservationState {
  RESERVED
  ASSIGNED
  VOIDED
  HELD

  @@map("number_reservation_state")
}

/// How a number came to exist. `AUTOMATIC` is the workflow path; `MANUAL` is a controller acting
/// under `numbering:manage`; `IMPORTED` is a legacy number supplied with a migrated document (§3).
enum NumberOrigin {
  AUTOMATIC
  MANUAL
  IMPORTED

  @@map("number_origin")
}

enum PreviewArtifactKind {
  PAGE_IMAGE
  THUMBNAIL
  PDF
  TEXT
  /// Text read off the pixels by an OCR engine — an inference with a confidence, never the
  /// file's own words. `ocr_result` carries the engine, version, language and confidence.
  OCR

  @@map("preview_artifact_kind")
}

/// Where rendering stands for a revision. `UNSUPPORTED` is a terminal answer, not a failure.
enum PreviewRenderState {
  PENDING
  READY
  FAILED
  UNSUPPORTED

  @@map("preview_render_state")
}

/// Stored bytes, and everything true about them independently of what they mean.
///
/// Immutable after creation and identified by content: the storage key is derived from the
/// SHA-256, so identical content within a tenant is one blob with a reference count
/// ([ADR-0007](../docs/architecture/adr/0007-storage-port-and-content-addressing.md)).
/// `uq (tenant_id, checksum_sha256)` is what makes that true rather than merely intended.
///
/// **Dedupe never crosses tenants**, and under ADR-0015 it cannot: the storage port scopes every
/// key with the tenant's prefix, so a shared blob would have to be addressed with a key the port
/// refuses. Two customers holding the same standard form is two objects, and the storage saved by
/// sharing one is not worth a reference count spanning a trust boundary.
///
/// `derived` marks a preview, thumbnail or OCR output. They are disposable — regenerable from the
/// original — so they are excluded from quota accounting and purged with their source.
model FileObject {
  id             String     @id @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  /// Lower-case hex. The key is derived from it, so the two can never disagree.
  checksumSha256 String     @map("checksum_sha256") @db.Char(64)
  sizeBytes      BigInt     @map("size_bytes")
  /// The *sniffed* type, never the declared one. A declaration that disagreed with the bytes
  /// was refused before this row existed (`17-security-architecture.md` §5).
  mimeType       String     @map("mime_type")
  /// What a use case names. Without the tenant prefix: the prefix says where the bytes live, not
  /// what the blob is, so a tenant moving container does not rewrite every row here.
  storageKey     String     @map("storage_key")
  /// Which driver wrote it. Recorded per blob so a copy-through provider migration keeps both
  /// readable throughout (`11-storage-architecture.md` §8).
  storageDriver  String     @map("storage_driver")
  scanStatus     ScanStatus @default(PENDING) @map("scan_status")
  /// The signature name when infected; null otherwise.
  scanThreat     String?    @map("scan_threat")
  scanner        String?
  scannedAt      DateTime?  @map("scanned_at") @db.Timestamptz(6)
  /// References from revisions and preview artefacts. Maintained transactionally with the write
  /// that creates or removes a reference, and reconciled by a sweeper that reports drift rather
  /// than silently fixing it.
  refCount       Int        @default(0) @map("ref_count")
  derived        Boolean    @default(false)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?    @map("created_by") @db.Uuid
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?    @map("updated_by") @db.Uuid
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz(6)
  deletedBy      String?    @map("deleted_by") @db.Uuid

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  revisions DocumentRevision[]
  previews  PreviewArtifact[]
  uploads   UploadSession[]

  /// Content addressing, as a constraint. Not partial on `deleted_at`: a blob that came back from
  /// a soft delete must be *the same blob*, and a second row for the same digest would be a second
  /// reference count for one object.
  @@unique([tenantId, checksumSha256], map: "uq_file_object_checksum")
  @@unique([tenantId, storageKey], map: "uq_file_object_key")
  /// The retention sweeper's only query: unreferenced blobs, oldest first.
  @@index([tenantId, refCount], map: "ix_file_object_refcount")
  @@index([tenantId, scanStatus], map: "ix_file_object_scan")
  @@map("file_object")
}

/// One upload in flight.
///
/// It exists because the API issues a target and then hears nothing until the client says it is
/// done: without a row there is no record that a key was promised to anybody, so an abandoned
/// upload would leave a blob nothing references and nothing knows to sweep
/// (`11-storage-architecture.md` §8).
///
/// It carries what the *client claimed* — filename, declared type, size — which is exactly why
/// those are not on `file_object`. They are a claim until the store's own answer confirms them at
/// completion, and keeping the claim separate from the fact is what lets a mismatch be detected
/// rather than overwritten.
model UploadSession {
  id                String             @id @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  /// As the client named it. Sanitised, never trusted: the stored key comes from the digest.
  filename          String
  declaredMimeType  String             @map("declared_mime_type")
  declaredSizeBytes BigInt             @map("declared_size_bytes")
  /// Where the bytes are being written. Unprefixed, like every stored key.
  targetKey         String             @map("target_key")
  state             UploadSessionState @default(OPEN)
  /// The driver's handle for a resumable transfer; null for a single PUT.
  multipartUploadId String?            @map("multipart_upload_id")
  /// Set at completion. The session is the audit trail of how this blob arrived.
  fileObjectId      String?            @map("file_object_id") @db.Uuid
  expiresAt         DateTime           @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String?            @map("created_by") @db.Uuid
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy         String?            @map("updated_by") @db.Uuid

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fileObject FileObject? @relation(fields: [fileObjectId], references: [id], onDelete: Restrict)

  /// The sweeper's query: open sessions past their expiry.
  @@index([tenantId, state, expiresAt], map: "ix_upload_session_expiry")
  @@map("upload_session")
}

/// The controlled record. The product's root aggregate.
///
/// Its identity never changes: not when it is revised, not when it moves folder, not when it is
/// archived, and not when it is deleted — the number stays reserved forever precisely so it can
/// never be re-issued (`03-domain-model.md` §3).
///
/// The **frozen policy** columns are the reason a document type can be edited without rewriting
/// history. A document copies what it needs at creation — its confidentiality level, its retention
/// policy — and keeps it. Editing the type afterwards applies to documents created later and to
/// nothing that already exists.
///
/// `document_number` is null until approval: numbers are reserved at submission and assigned at
/// approval, inside the approval's own transaction
/// ([ADR-0004](../docs/architecture/adr/0004-numbering-assigned-at-approval.md)).
model Document {
  id                String         @id @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  /// Where it lives. Moving it changes the ACL chain it resolves through, which is why the move
  /// is its own permission and its own audited operation.
  folderId          String         @map("folder_id") @db.Uuid
  documentTypeId    String         @map("document_type_id") @db.Uuid
  categoryId        String?        @map("category_id") @db.Uuid
  /// Frozen from the type at creation, and overridable upward by anyone who may. Never inherited
  /// live from the type: raising a type's default must not silently declassify existing documents.
  confidentialityId String         @map("confidentiality_id") @db.Uuid
  /// Frozen from the type at creation. Null when the type names no retention policy.
  retentionPolicyId String?        @map("retention_policy_id") @db.Uuid
  title             String
  description       String?
  status            DocumentStatus @default(DRAFT)
  origin            DocumentOrigin @default(UPLOAD)
  /// Assigned once, at approval, and never reused — even after deletion. Null until then.
  documentNumber    String?        @map("document_number")
  /// When the number was assigned — the instant `YEAR`/`MONTH` segments were rendered against,
  /// in the tenant's timezone. Set with `document_number` and only with it.
  numberedAt        DateTime?      @map("numbered_at") @db.Timestamptz(6)
  ownerUserId       String         @map("owner_user_id") @db.Uuid
  /// The effective revision. Null until one is published, which is Phase 4's work.
  currentRevisionId String?        @unique(map: "uq_document_current_revision") @map("current_revision_id") @db.Uuid
  /// The newest revision, published or not. Set by Phase 3 the moment the first one exists.
  latestRevisionId  String?        @map("latest_revision_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String?        @map("created_by") @db.Uuid
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy         String?        @map("updated_by") @db.Uuid
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(6)
  deletedBy         String?        @map("deleted_by") @db.Uuid
  /// Why it was deleted. Required at delete time and cleared by a restore.
  ///
  /// A column rather than only an audit payload, because the recycle bin shows it beside the row —
  /// and a reason a reader has to open the audit trail to see is a reason nobody reads before
  /// deciding whether to put something back.
  deleteReason      String?        @map("delete_reason")
  /// Which cascade removed this row: the folder delete that took the subtree, or the document's
  /// own delete. Cleared by the restore that reverses it, exactly as `folder.delete_cascade_id` is
  /// — restoring "everything currently deleted under this node" would resurrect what somebody
  /// removed deliberately beforehand (`05-database-design.md` §4).
  deleteCascadeId   String?        @map("delete_cascade_id") @db.Uuid
  version           Int            @default(1)

  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  folder             Folder                  @relation(fields: [folderId], references: [id], onDelete: Restrict)
  documentType       DocumentType            @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  category           Category?               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  confidentiality    ConfidentialityLevel    @relation(fields: [confidentialityId], references: [id], onDelete: Restrict)
  retentionPolicy    RetentionPolicy?        @relation(fields: [retentionPolicyId], references: [id], onDelete: Restrict)
  currentRevision    DocumentRevision?       @relation("DocumentCurrentRevision", fields: [currentRevisionId], references: [id], onDelete: Restrict)
  revisions          DocumentRevision[]      @relation("RevisionDocument")
  metadataValues     DocumentMetadataValue[]
  favorites          DocumentFavorite[]
  views              DocumentView[]
  workflowInstances  WorkflowInstance[]
  numberReservations NumberReservation[]
  locks              DocumentLock[]
  retentionSchedules RetentionSchedule[]
  legalHolds         LegalHold[]

  /// Deliberately **not** partial on `deleted_at`. A number stays reserved forever, so a deleted
  /// document still holds its own — which is the one exception to this schema's rule that a
  /// deleted row never blocks a new one.
  @@unique([tenantId, documentNumber], map: "uq_document_number")
  /// The folder browser's query: what is in this folder, newest first.
  @@index([tenantId, folderId, deletedAt, updatedAt(sort: Desc)], map: "ix_document_folder")
  /// The recycle bin's query: what is deleted, most recently first.
  ///
  /// Partial on `deleted_at IS NOT NULL`, in the migration, and the partiality is the whole point.
  /// A live library is almost entirely live rows, so a full index on `deleted_at` would be an
  /// index of the whole table to answer a question about the thousandth of it that is deleted —
  /// and the recycle bin, the retention sweep and the disposition register all ask that question.
  @@index([tenantId, deleteCascadeId], map: "ix_document_cascade")
  /// "What am I working on" on the dashboard, and the owner filter in the library.
  @@index([tenantId, ownerUserId, status], map: "ix_document_owner")
  @@index([tenantId, documentTypeId], map: "ix_document_type")
  @@index([tenantId, categoryId], map: "ix_document_category")
  @@index([tenantId, status], map: "ix_document_status")
  @@map("document")
}

/// One controlled version of a document, and the bytes it is.
///
/// Phase 3 creates revision zero at upload and nothing else: check-out, check-in, compare and
/// restore are Phase 6's, and publishing is Phase 4's. What is here now is the record that binds a
/// document to a file, which is what makes "prove what was approved" answerable later — revision →
/// file → checksum (`10-revision-architecture.md` §1).
///
/// The ordinal is the truth and the label is rendered from it, in the style the document's type
/// chose. A label is a display convention; two documents of different types may show `R1` and `B`
/// for the same ordinal, and both are correct.
model DocumentRevision {
  id                     String         @id @db.Uuid
  tenantId               String         @map("tenant_id") @db.Uuid
  documentId             String         @map("document_id") @db.Uuid
  /// Contiguous and strictly increasing per document, from zero.
  ordinal                Int
  /// Rendered from the ordinal at creation, in the type's style. Stored rather than derived on
  /// read, because a type whose style changes must not silently relabel history.
  label                  String
  status                 RevisionStatus @default(DRAFT)
  fileObjectId           String         @map("file_object_id") @db.Uuid
  /// The filename as uploaded. What a download is named, and what the library shows beside a
  /// title somebody typed — the two are frequently different and both are wanted.
  filename               String
  /// What the author said about this revision. Free text, and not the document's description.
  changeNote             String?        @map("change_note")
  /// When this revision became the effective one. Set at publication and never cleared — a
  /// superseded revision keeps the instant it was published, which is half of its history.
  publishedAt            DateTime?      @map("published_at") @db.Timestamptz(6)
  /// The window this revision is (or was) effective for. On the revision rather than the
  /// document (`10-revision-architecture.md` §6): effective dates describe one controlled
  /// version, and the document's own effectiveness is its current revision's.
  effectiveFrom          DateTime?      @map("effective_from") @db.Date
  effectiveTo            DateTime?      @map("effective_to") @db.Date
  /// Set when this revision was created by restoring an older one. Restore never rewinds:
  /// it creates a new revision carrying old content, and this records which
  /// (`10-revision-architecture.md` §5).
  restoredFromRevisionId String?        @map("restored_from_revision_id") @db.Uuid
  /// Every tenant-defined metadata value as it stood at publication, so an approved revision
  /// can prove what the approver actually saw after the document's live metadata moves on
  /// (`10-revision-architecture.md` §6). Null until published.
  metadataSnapshot       Json?          @map("metadata_snapshot")
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy              String?        @map("created_by") @db.Uuid
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy              String?        @map("updated_by") @db.Uuid
  deletedAt              DateTime?      @map("deleted_at") @db.Timestamptz(6)
  deletedBy              String?        @map("deleted_by") @db.Uuid
  /// Which cascade removed this revision — always its document's.
  ///
  /// Phase 10 is where a document's delete started reaching its revisions at all. Before it, a
  /// deleted document kept every revision live and gave back the reference on only the latest, so
  /// a document with four revisions returned one and its blobs could never reach zero
  /// (`@edms/domain`'s `DOCUMENT_DELETION_RULES` is the whole table).
  deleteCascadeId        String?        @map("delete_cascade_id") @db.Uuid
  version                Int            @default(1)

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document          Document           @relation("RevisionDocument", fields: [documentId], references: [id], onDelete: Restrict)
  fileObject        FileObject         @relation(fields: [fileObjectId], references: [id], onDelete: Restrict)
  restoredFrom      DocumentRevision?  @relation("RevisionRestoredFrom", fields: [restoredFromRevisionId], references: [id], onDelete: Restrict)
  restoredTo        DocumentRevision[] @relation("RevisionRestoredFrom")
  currentOf         Document[]         @relation("DocumentCurrentRevision")
  previews          PreviewArtifact[]
  previewRender     PreviewRender?
  ocrResult         OcrResult?
  workflowInstances WorkflowInstance[]
  locksCheckedOut   DocumentLock[]     @relation("LockCheckedOutRevision")
  locksDrafting     DocumentLock[]     @relation("LockDraftRevision")

  /// Not partial: an ordinal is never re-used, so a deleted revision still holds its place. A
  /// history with a gap and a history with two revision 2s are both unusable as evidence.
  @@unique([documentId, ordinal], map: "uq_revision_ordinal")
  @@index([tenantId, documentId, ordinal(sort: Desc)], map: "ix_revision_document")
  @@index([tenantId, fileObjectId], map: "ix_revision_file")
  /// What one cascade took, which is exactly what its restore puts back.
  @@index([tenantId, deleteCascadeId], map: "ix_revision_cascade")
  @@map("document_revision")
}

/// The check-out lock: one person's exclusive claim on producing a document's next revision.
///
/// A row per check-out rather than a flag on the document, because the history is the point:
/// who held it, since when, how it ended and why are compliance questions, and a boolean
/// answers none of them. The live lock is the row with `released_at IS NULL`, and
/// `uq_document_lock_live` (partial, in the migration — Prisma cannot express it) is what
/// makes two racing check-outs produce one lock and one refusal rather than two locks —
/// the same shape, for the same reason, as `uq_workflow_instance_live`.
model DocumentLock {
  id                   String                     @id @db.Uuid
  tenantId             String                     @map("tenant_id") @db.Uuid
  documentId           String                     @map("document_id") @db.Uuid
  lockedBy             String                     @map("locked_by") @db.Uuid
  /// The published revision the holder took away to edit — what "editing from" resolves to.
  checkedOutRevisionId String?                    @map("checked_out_revision_id") @db.Uuid
  /// The working draft checked in under this lock while it stays held. Null until a check-in
  /// keeps the lock; cancelling the check-out discards the revision this names.
  draftRevisionId      String?                    @map("draft_revision_id") @db.Uuid
  acquiredAt           DateTime                   @map("acquired_at") @db.Timestamptz(6)
  /// When the claim lapses, computed at acquisition from the tenant's own setting. An expired
  /// live lock no longer excludes anybody; the next operation releases it as `EXPIRED`.
  expiresAt            DateTime                   @map("expires_at") @db.Timestamptz(6)
  releasedAt           DateTime?                  @map("released_at") @db.Timestamptz(6)
  releasedBy           String?                    @map("released_by") @db.Uuid
  releaseReason        DocumentLockReleaseReason? @map("release_reason")
  /// Required when the release was forced: taking somebody's lock away is an act that has to
  /// answer "why", and the audit event carries the same sentence.
  releaseNote          String?                    @map("release_note")
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy            String?                    @map("created_by") @db.Uuid
  updatedAt            DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy            String?                    @map("updated_by") @db.Uuid
  version              Int                        @default(1)

  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document           Document          @relation(fields: [documentId], references: [id], onDelete: Restrict)
  holder             User              @relation(fields: [lockedBy], references: [id], onDelete: Restrict)
  checkedOutRevision DocumentRevision? @relation("LockCheckedOutRevision", fields: [checkedOutRevisionId], references: [id], onDelete: Restrict)
  draftRevision      DocumentRevision? @relation("LockDraftRevision", fields: [draftRevisionId], references: [id], onDelete: Restrict)

  /// "Who has this checked out, and who had it" — the lock history of one document.
  @@index([tenantId, documentId, acquiredAt(sort: Desc)], map: "ix_document_lock_document")
  /// "What do I have checked out" — one person's live claims.
  @@index([tenantId, lockedBy], map: "ix_document_lock_holder")
  @@map("document_lock")
}

/// One tenant-defined field's value on one document.
///
/// **Typed columns rather than `jsonb`.** The tenant defines which fields exist; the product knows
/// what a date is. A `jsonb` bag would make "documents expiring this quarter" a scan and a cast,
/// and would let a `NUMBER` field hold the string a form posted. Exactly one value column is
/// populated, decided by the field's own `data_type` — which is immutable for precisely this
/// reason (`05-database-design.md`).
///
/// `MULTI_SELECT` is the one field kind whose value is a list, and it gets a text array rather than
/// a row per option: the options are a closed set the field itself defines, and a join table would
/// buy nothing but a join.
model DocumentMetadataValue {
  tenantId        String    @map("tenant_id") @db.Uuid
  documentId      String    @map("document_id") @db.Uuid
  metadataFieldId String    @map("metadata_field_id") @db.Uuid
  textValue       String?   @map("text_value")
  numberValue     Decimal?  @map("number_value") @db.Decimal(38, 10)
  dateValue       DateTime? @map("date_value") @db.Timestamptz(6)
  booleanValue    Boolean?  @map("boolean_value")
  /// A user or a department identifier, for the two field kinds that name one.
  referenceValue  String?   @map("reference_value") @db.Uuid
  selectValues    String[]  @map("select_values")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?   @map("created_by") @db.Uuid
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy       String?   @map("updated_by") @db.Uuid

  document Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  field    MetadataField @relation(fields: [metadataFieldId], references: [id], onDelete: Restrict)

  @@id([documentId, metadataFieldId])
  /// "Which documents have this field set to that" — the metadata filter, and what a field's
  /// deletion has to ask before it refuses.
  @@index([tenantId, metadataFieldId, textValue], map: "ix_metadata_value_text")
  @@index([tenantId, metadataFieldId, dateValue], map: "ix_metadata_value_date")
  @@index([tenantId, metadataFieldId, numberValue], map: "ix_metadata_value_number")
  @@map("document_metadata_value")
}

/// A document one person marked.
///
/// Per user rather than per tenant, and that is the whole model: a favourite is a private
/// convenience, not a shared classification. A tenant-wide "important" flag is a metadata field the
/// administrator defines, and conflating the two would make one person's shortcut everybody's
/// taxonomy.
model DocumentFavorite {
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, documentId])
  /// "My favourites, most recently added first."
  @@index([tenantId, userId, createdAt(sort: Desc)], map: "ix_favorite_user")
  @@map("document_favorite")
}

/// When each person last opened each document.
///
/// One row per (user, document), updated in place, rather than an append-only log. "Recent
/// documents" asks *which* documents, not how many times — and a log would grow without bound to
/// answer a question about at most a screenful of rows.
///
/// It is deliberately **not** derived from the audit trail, though the trail records every read.
/// Audit is evidence: append-only, hash-chained, retained by policy and never pruned to make a
/// list faster. Serving a convenience feature from it would put a product query on the critical
/// path of the one table that must stay cheap to write and impossible to rewrite
/// (`13-audit-architecture.md`).
model DocumentView {
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  viewedAt   DateTime @map("viewed_at") @db.Timestamptz(6)
  viewCount  Int      @default(1) @map("view_count")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, documentId])
  /// The only query this table serves.
  @@index([tenantId, userId, viewedAt(sort: Desc)], map: "ix_view_user")
  @@map("document_view")
}

/// Something rendered from a revision's content.
///
/// Phase 3 produces exactly one kind — the upload-time `THUMBNAIL` — and the table is the full
/// shape because Phase 7 adds page images, a PDF rendition and extracted text without a migration.
/// Every artefact is disposable: it can be rebuilt from the source blob, so it is content-addressed
/// like any other file, marked `derived`, excluded from quota and purged with its source
/// (`14-preview-architecture.md`).
model PreviewArtifact {
  id              String              @id @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  revisionId      String              @map("revision_id") @db.Uuid
  kind            PreviewArtifactKind
  /// Null for an artefact that is not per page — a thumbnail, the extracted text.
  page            Int?
  fileObjectId    String              @map("file_object_id") @db.Uuid
  /// Which renderer produced it, so an upgrade can invalidate what the old version made.
  renderer        String
  rendererVersion String              @map("renderer_version")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?             @map("created_by") @db.Uuid
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy       String?             @map("updated_by") @db.Uuid

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  revision   DocumentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  fileObject FileObject       @relation(fields: [fileObjectId], references: [id], onDelete: Restrict)

  /// One artefact per revision, kind and page. A second would be two answers to "what does page
  /// three look like", and nothing could say which is current. `page` is nullable, so the
  /// migration recreates this index `NULLS NOT DISTINCT` — a plain unique index treats every
  /// NULL as distinct and would happily store two thumbnails (the same reason
  /// `uq_document_lock_live` lives in raw SQL).
  @@unique([revisionId, kind, page], map: "uq_preview_artifact")
  @@index([tenantId, revisionId], map: "ix_preview_revision")
  @@map("preview_artifact")
}

/// Where rendering stands for one revision — the row behind "202 with status" and behind the
/// operator's view of a failure (`14-preview-architecture.md` §§4, 7).
///
/// One row per revision, upserted by the preview consumer. The artefact rows are the evidence
/// that pages exist; this is the answer when they do not yet, or never will: `PENDING` while the
/// queue works, `FAILED` with an operator-readable reason when the renderer gave up,
/// `UNSUPPORTED` when no renderer claims the format and the UI should offer download instead.
model PreviewRender {
  id              String             @id @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  revisionId      String             @unique(map: "uq_preview_render_revision") @map("revision_id") @db.Uuid
  state           PreviewRenderState @default(PENDING)
  /// Why it failed or is unsupported, in a sentence an administrator can act on. Null when READY.
  reason          String?
  /// Which renderer answered, recorded even on failure so an upgrade knows what to retry.
  renderer        String?
  rendererVersion String?            @map("renderer_version")
  /// Pages the renderer reported. Null until READY.
  pageCount       Int?               @map("page_count")
  attempts        Int                @default(0)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?            @map("created_by") @db.Uuid
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy       String?            @map("updated_by") @db.Uuid

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  revision DocumentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([tenantId, state], map: "ix_preview_render_state")
  @@map("preview_render")
}

/// What an OCR engine read off a revision's pixels — metadata about the file, never the file.
///
/// The text itself is stored as a `preview_artifact` of kind `OCR` (a derived `FileObject`, like
/// every other artefact); this row carries what the artefact bytes cannot: which engine, which
/// version, which language, and how confident it was — so a low-confidence result can be flagged
/// in the UI rather than presented as authoritative (`14-preview-architecture.md` §6).
model OcrResult {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  revisionId     String   @unique(map: "uq_ocr_result_revision") @map("revision_id") @db.Uuid
  engine         String
  engineVersion  String   @map("engine_version")
  /// The language(s) the engine was asked to read, e.g. `ara+eng`.
  language       String
  /// Mean word confidence, 0–100 as the engine reports it.
  confidence     Int      @db.SmallInt
  characterCount Int      @map("character_count")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?  @map("updated_by") @db.Uuid

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  revision DocumentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@map("ocr_result")
}

// ---------------------------------------------------------------------------------------
// Phase 4 — the workflow engine.
//
//   Phase 2 built the *definitions*: a workflow is versioned data, and a published version is
//   immutable. These are the tables that read one. The split runs all the way down — a
//   definition says "the author's manager approves"; an instance says "Dana approved, on
//   Tuesday, under version 3" — and it is what makes "which rules was this approved under"
//   answerable years after somebody edited the workflow
//   (`docs/architecture/07-workflow-architecture.md` §1).
//
//   Four shapes recur here and each is load-bearing:
//
//     A **task is decided once**. `decision` is nullable and the update that fills it carries
//     `AND decision IS NULL` in its `WHERE`; zero rows affected is a conflict, never an
//     overwrite. A duplicate approval corrupts a quorum count, which is the one arithmetic in
//     this product an auditor will re-derive by hand (§8).
//
//     **Timers are rows, not only jobs.** BullMQ holds the delayed job; `workflow_timer` holds
//     what the job is *for*. That is what lets a stage cancel its timers, a paused instance
//     store the time it had left and resume with it rather than restarting the clock (§6), and
//     a reminder record that it has already fired.
//
//     **Both identities travel together.** A task carries who it belongs to and who decided
//     it. Delegation is Phase 11 and is not built here, but a task that could only record one
//     person would have to be migrated before it could be — so the columns exist and the audit
//     already reads them (§4).
//
//     **Nothing here is soft-deleted.** An approval is evidence. A workflow that ends without a
//     decision is `CANCELLED` with a stated reason; there is no state in which a decision was
//     taken and the row that records it is gone.
//
//   Two configuration tables arrive with the engine because the engine cannot resolve without
//   them: the working-day calendar deadlines are counted against (§6), and the approval groups
//   the `GROUP` participant resolver names (§2).
// ---------------------------------------------------------------------------------------

/// Why a stage's tasks exist and what ends it.
enum WorkflowInstanceState {
  RUNNING
  /// Timers are stopped and the remaining duration is stored. Nothing decides while paused.
  PAUSED
  COMPLETED
  REJECTED
  CANCELLED

  @@map("workflow_instance_state")
}

enum WorkflowStageState {
  PENDING
  ACTIVE
  COMPLETED
  /// The stage's condition did not hold. Never used for "nobody resolved" — that fails loudly.
  SKIPPED
  /// The instance ended before this stage ran.
  CANCELLED

  @@map("workflow_stage_state")
}

/// What happened to one person's task, independently of what they decided.
///
/// Separate from `decision` because the two answer different questions. `SUPERSEDED` is an `ANY`
/// stage's other tasks once somebody approved; `WITHDRAWN` is a task the instance ended under.
/// Both are undecided, and neither is pending — a distinction an approval inbox has to make.
enum ApprovalTaskState {
  PENDING
  DECIDED
  WITHDRAWN
  SUPERSEDED

  @@map("approval_task_state")
}

enum TaskDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED

  @@map("task_decision")
}

/// What a scheduled timer is for.
enum WorkflowTimerKind {
  DEADLINE
  REMINDER

  @@map("workflow_timer_kind")
}

enum WorkflowTimerState {
  SCHEDULED
  /// Held while its instance is paused, with `remaining_ms` carrying what was left.
  PAUSED
  FIRED
  CANCELLED

  @@map("workflow_timer_state")
}

/// One approval attempt on one revision of one document.
///
/// It binds to a **version**, never to a definition. Publishing a new version leaves this row
/// reading the rules it started under, which `07-workflow-architecture.md` §1 calls the single
/// most important property of the engine — and which is why `workflow_version` has no delete.
model WorkflowInstance {
  id                String                @id @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  documentId        String                @map("document_id") @db.Uuid
  /// The revision the approvers are deciding on. The bytes are frozen from submission, so this
  /// is what "prove what was approved" resolves through: instance → revision → file → checksum.
  revisionId        String                @map("revision_id") @db.Uuid
  definitionId      String                @map("definition_id") @db.Uuid
  workflowVersionId String                @map("workflow_version_id") @db.Uuid
  state             WorkflowInstanceState @default(RUNNING)
  /// The stage being decided. `-1` before the first activates and after the last completes, so
  /// "which stage" never has to be inferred from a join.
  currentStageIndex Int                   @default(-1) @map("current_stage_index")
  startedAt         DateTime              @map("started_at") @db.Timestamptz(6)
  startedBy         String?               @map("started_by") @db.Uuid
  endedAt           DateTime?             @map("ended_at") @db.Timestamptz(6)
  /// `WorkflowCancellationReason` for a cancellation; null otherwise. Never a free-text note —
  /// the note is a comment, and the reason is what a report groups by.
  endReason         String?               @map("end_reason")
  pausedAt          DateTime?             @map("paused_at") @db.Timestamptz(6)
  pauseReason       String?               @map("pause_reason")
  /// How many escalations this instance has spent, against the definition's `maxEscalations`.
  /// On the instance rather than the stage: a definition that escalates twice per stage across
  /// six stages has escalated twelve times, and the cap is meant to stop a loop, not a stage.
  escalationCount   Int                   @default(0) @map("escalation_count")
  /// Set at completion when the definition's `onComplete.assignNumber` drew a number
  /// ([ADR-0004](../docs/architecture/adr/0004-numbering-assigned-at-approval.md)).
  numberAssigned    Boolean               @default(false) @map("number_assigned")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String?               @map("created_by") @db.Uuid
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy         String?               @map("updated_by") @db.Uuid
  version           Int                   @default(1)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document           Document            @relation(fields: [documentId], references: [id], onDelete: Restrict)
  revision           DocumentRevision    @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  definition         WorkflowDefinition  @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  workflowVersion    WorkflowVersion     @relation(fields: [workflowVersionId], references: [id], onDelete: Restrict)
  stages             WorkflowStage[]
  tasks              ApprovalTask[]
  comments           WorkflowComment[]
  timers             WorkflowTimer[]
  numberReservations NumberReservation[]

  /// The approval history of one document, newest attempt first.
  @@index([tenantId, documentId, startedAt(sort: Desc)], map: "ix_workflow_instance_document")
  @@index([tenantId, state], map: "ix_workflow_instance_state")
  /// "How many approvals bound to this version" — the count that makes a version undeletable.
  @@index([tenantId, workflowVersionId], map: "ix_workflow_instance_version")
  @@map("workflow_instance")
}

/// One stage of a running instance.
///
/// The definition's stage is copied here at activation rather than read back through the version
/// on every query. Not denormalisation for speed: a stage's *condition* is evaluated once, at
/// activation, against the document as it was then — so what the stage is running under has to be
/// recorded, or "why did this stage not run" would have no answer.
model WorkflowStage {
  id             String             @id @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  instanceId     String             @map("instance_id") @db.Uuid
  /// Position in the definition. Contiguous from zero, because the definition's stages are an
  /// array and their index is their order.
  index          Int
  name           String
  completionRule String             @map("completion_rule")
  /// The count for `QUORUM`, the percentage for `PERCENT`. Null for `ALL` and `ANY`.
  threshold      Int?
  /// Tasks inside this stage run in sequence rather than in parallel.
  ordered        Boolean            @default(false)
  state          WorkflowStageState @default(PENDING)
  activatedAt    DateTime?          @map("activated_at") @db.Timestamptz(6)
  completedAt    DateTime?          @map("completed_at") @db.Timestamptz(6)
  /// When this stage becomes overdue. Computed at activation against the working-day calendar,
  /// stored rather than recomputed: a tenant that adds a public holiday must not retroactively
  /// move a deadline somebody has already been told about.
  dueAt          DateTime?          @map("due_at") @db.Timestamptz(6)
  /// Why the stage was skipped, when it was. `CONDITION_FALSE` is the only value the engine
  /// writes; a stage is never skipped for want of participants (§8).
  skipReason     String?            @map("skip_reason")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int                @default(1)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  instance WorkflowInstance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  tasks    ApprovalTask[]
  comments WorkflowComment[]
  timers   WorkflowTimer[]

  @@unique([instanceId, index], map: "uq_workflow_stage_index")
  @@index([tenantId, instanceId], map: "ix_workflow_stage_instance")
  @@map("workflow_stage")
}

/// One resolved approver's task.
///
/// **Decided once.** `decision` is null until somebody decides, and the statement that fills it
/// names `decision IS NULL` in its `WHERE`. Zero rows affected is a `409`, not a retry — two
/// approvals from one task would make a quorum count say something that never happened (§3).
model ApprovalTask {
  id              String            @id @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  instanceId      String            @map("instance_id") @db.Uuid
  stageId         String            @map("stage_id") @db.Uuid
  /// Whose task this is. The delegator, when a delegation is in play — the task never moves.
  assigneeId      String            @map("assignee_id") @db.Uuid
  /// Which resolver produced this assignee, for "why am I being asked to approve this".
  resolvedBy      String            @map("resolved_by")
  /// Position within an `ordered` stage. Zero for a parallel stage, where nothing is first.
  sequence        Int               @default(0)
  state           ApprovalTaskState @default(PENDING)
  decision        TaskDecision?
  /// Who actually decided. Equal to `assignee_id` unless a delegate acted (§4).
  decidedById     String?           @map("decided_by_id") @db.Uuid
  /// The delegator, set only when somebody decided on another person's behalf. Both identities
  /// are here and in the audit event, which is what makes "who decided, and for whom" answerable
  /// before delegation is built.
  onBehalfOfId    String?           @map("on_behalf_of_id") @db.Uuid
  /// Which delegation authorised the decision, when one did (Phase 11).
  ///
  /// A third column rather than an inference from the pair above, and it earns its place: the pair
  /// cannot say *which* arrangement, and two people may have delegated to each other more than once.
  /// The foreign key restricts, so the delegation a decision was taken under can never be deleted —
  /// a revoked delegation is exactly the one an investigation asks about, and revocation is a status
  /// change here rather than a deletion.
  ///
  /// It is deliberately **not** what makes the decision attestable. Phase 9's digest covers
  /// `on_behalf_of_id` and not a column added after it, so this is a queryable link and the
  /// `DELEGATION_USED` audit event written in the same transaction is the attested one.
  delegationId    String?           @map("delegation_id") @db.Uuid
  decidedAt       DateTime?         @map("decided_at") @db.Timestamptz(6)
  /// Required for a rejection and for a request for changes (`06-document-lifecycle.md` §3).
  comment         String?
  dueAt           DateTime?         @map("due_at") @db.Timestamptz(6)
  /// The task this one escalated from, so an escalation chain reads in both directions.
  escalatedFromId String?           @map("escalated_from_id") @db.Uuid
  /// True when the engine decided this task itself, under a stage marked non-controlling.
  autoDecided     Boolean           @default(false) @map("auto_decided")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int               @default(1)

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  instance      WorkflowInstance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stage         WorkflowStage     @relation(fields: [stageId], references: [id], onDelete: Cascade)
  assignee      User              @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  escalatedFrom ApprovalTask?     @relation("TaskEscalation", fields: [escalatedFromId], references: [id], onDelete: Restrict)
  escalations   ApprovalTask[]    @relation("TaskEscalation")
  delegation    Delegation?       @relation(fields: [delegationId], references: [id], onDelete: Restrict)
  comments      WorkflowComment[]
  timers        WorkflowTimer[]

  /// One resolver may not produce the same person twice in one stage: two tasks for one person
  /// would count twice toward a quorum. Enforced here rather than only in the resolver, because
  /// the resolver is where the de-duplication is easy to forget.
  @@unique([stageId, assigneeId], map: "uq_approval_task_assignee")
  /// The approval inbox. Partial on the state in the query rather than the index, because a
  /// person's decided tasks are a list the same screen shows.
  @@index([tenantId, assigneeId, state, dueAt], map: "ix_approval_task_inbox")
  @@index([tenantId, instanceId], map: "ix_approval_task_instance")
  @@index([tenantId, stageId], map: "ix_approval_task_stage")
  @@map("approval_task")
}

/// Something somebody said about an approval.
///
/// Attached to the instance always, and to a stage and a task when it accompanied a decision.
/// A decision's comment is stored on the task *and* here: the task's copy is the record of that
/// decision and never changes, and this is the conversation, in order, that a reviewer reads.
model WorkflowComment {
  id         String        @id @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  instanceId String        @map("instance_id") @db.Uuid
  documentId String        @map("document_id") @db.Uuid
  stageId    String?       @map("stage_id") @db.Uuid
  taskId     String?       @map("task_id") @db.Uuid
  authorId   String        @map("author_id") @db.Uuid
  body       String
  /// The decision this comment was made with, when it was made with one. Null for a remark.
  decision   TaskDecision?
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stage    WorkflowStage?   @relation(fields: [stageId], references: [id], onDelete: Cascade)
  task     ApprovalTask?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author   User             @relation(fields: [authorId], references: [id], onDelete: Restrict)

  /// The timeline: one instance's comments, oldest first, which is how a conversation reads.
  @@index([tenantId, instanceId, createdAt], map: "ix_workflow_comment_instance")
  @@index([tenantId, documentId, createdAt(sort: Desc)], map: "ix_workflow_comment_document")
  @@map("workflow_comment")
}

/// A scheduled deadline or reminder, as a row.
///
/// The queue holds the delayed job; this holds what it is for. Three things need that and none of
/// them can be answered by BullMQ: cancelling a stage has to cancel exactly its timers, a paused
/// instance has to store the time each timer had left and resume with **that** rather than
/// restarting the clock (§6), and a reminder has to record that it has already fired.
///
/// `job_id` is deterministic — derived from this row's identifier — so an at-least-once delivery
/// that arrives twice is one job, and a re-enqueue after a pause replaces rather than duplicates.
model WorkflowTimer {
  id          String             @id @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  instanceId  String             @map("instance_id") @db.Uuid
  stageId     String             @map("stage_id") @db.Uuid
  /// Set for a per-task reminder; null for a stage deadline.
  taskId      String?            @map("task_id") @db.Uuid
  kind        WorkflowTimerKind
  state       WorkflowTimerState @default(SCHEDULED)
  /// When it is due to fire. Recomputed on resume from `remaining_ms`, never re-derived from the
  /// original duration — which is what "resumes with the remaining duration" means.
  fireAt      DateTime           @map("fire_at") @db.Timestamptz(6)
  /// What was left when the instance paused. Null whenever the timer is not paused.
  remainingMs Int?               @map("remaining_ms")
  firedAt     DateTime?          @map("fired_at") @db.Timestamptz(6)
  /// The offset this reminder was scheduled at, so "which reminder" reads without arithmetic.
  offset      String?
  jobId       String             @map("job_id")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stage    WorkflowStage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  task     ApprovalTask?    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  /// The dispatcher's and the consumer's shared key. Unique per tenant so a job identifier can
  /// never address two timers.
  @@unique([tenantId, jobId], map: "uq_workflow_timer_job")
  @@index([tenantId, instanceId, state], map: "ix_workflow_timer_instance")
  @@index([tenantId, state, fireAt], map: "ix_workflow_timer_due")
  @@map("workflow_timer")
}

/// A named set of people a workflow stage can address.
///
/// Administration's, not the engine's — the `GROUP` resolver names one by key and the engine
/// never learns what is in it (§2, §8). It exists because a resolver that cannot resolve fails a
/// submission loudly, so shipping the engine without the surface behind one of its resolver kinds
/// would ship a definition that cannot be published usefully.
///
/// Deliberately not a role. A role carries permissions and is resolved on every request; a group
/// is a routing list with no authority of its own, and conflating them would make "add Sam to the
/// safety reviewers" a permission grant.
model ApprovalGroup {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  key         String
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy   String?   @map("deleted_by") @db.Uuid
  version     Int       @default(1)

  tenant  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  members ApprovalGroupMember[]

  @@index([tenantId, isActive], map: "ix_approval_group_active")
  @@map("approval_group")
}

model ApprovalGroupMember {
  tenantId   String   @map("tenant_id") @db.Uuid
  groupId    String   @map("group_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedBy String?  @map("assigned_by") @db.Uuid

  group ApprovalGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([tenantId, userId], map: "ix_approval_group_member_user")
  @@map("approval_group_member")
}

/// The working-day calendar a deadline duration is counted against.
///
/// `07-workflow-architecture.md` §6 says Administration owns this, and until now Administration
/// had no calendar — while `WORKING_DAYS` is the *default* every stage deadline is authored with.
/// A seam here would have meant every deadline in the product silently counting weekends, so the
/// calendar is built rather than deferred.
///
/// Per entity, because a group with offices in two countries genuinely has two working weeks. One
/// calendar per tenant is marked `is_default` and is what a document whose entity names none uses.
model WorkingCalendar {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  code        String
  name        String
  /// Null for the tenant-wide calendar. Set for one that belongs to a single legal entity.
  entityId    String?   @map("entity_id") @db.Uuid
  /// ISO-8601 weekday numbers that are not worked: 1 is Monday, 7 is Sunday. An array rather
  /// than seven booleans, because "which days are the weekend" is one fact and a Friday-Saturday
  /// weekend is as ordinary as a Saturday-Sunday one.
  weekendDays Int[]     @map("weekend_days")
  /// The tenant's fallback. Exactly one live row per tenant carries it, enforced by a partial
  /// unique index — a tenant with two defaults has no default.
  isDefault   Boolean   @default(false) @map("is_default")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy   String?   @map("deleted_by") @db.Uuid
  version     Int       @default(1)

  tenant   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entity   Entity?                  @relation(fields: [entityId], references: [id], onDelete: Restrict)
  holidays WorkingCalendarHoliday[]

  @@index([tenantId, entityId], map: "ix_working_calendar_entity")
  @@map("working_calendar")
}

/// A day the calendar does not work.
///
/// A date rather than a timestamp: a public holiday is a calendar day in the tenant's own
/// timezone, and storing an instant would make it land on the wrong day for half the world.
model WorkingCalendarHoliday {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  calendarId String   @map("calendar_id") @db.Uuid
  day        DateTime @db.Date
  name       String

  calendar WorkingCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, day], map: "uq_working_calendar_holiday")
  @@index([tenantId, calendarId, day], map: "ix_working_calendar_holiday")
  @@map("working_calendar_holiday")
}

// ── Phase 8 — search ─────────────────────────────────────────────────────────────────────────

/// Where an index entry's body text came from.
///
/// `TEXT` is the file's own words, read from its text layer; `OCR` is what an engine read off
/// pixels. The distinction survives into the index because a hit found through a low-confidence
/// OCR read is presented as an inference, not as the document's words — the same honesty rule
/// the compare API follows (`14-preview-architecture.md` §6).
enum SearchContentSource {
  TEXT
  OCR

  @@map("search_content_source")
}

enum SearchRebuildState {
  RUNNING
  COMPLETED
  FAILED

  @@map("search_rebuild_state")
}

/// The search read model — one row per findable document (`12-search-architecture.md` §2).
///
/// Never authoritative and rebuildable from source at any time (ADR-0008). The `tsv` column and
/// the GIN/opclass indexes over it live in raw SQL because Prisma cannot express them — the
/// same reason `uq_document_lock_live` lives in its migration. Every read and write of this
/// table goes through the search adapters as SQL; the model exists so the schema stays the one
/// description of the database, and so tests can count rows without hand-writing queries.
///
/// **Deliberately no foreign keys beyond the tenant.** A read model references nothing
/// authoritatively: a `RESTRICT` edge to `document` would let a projection block a purge, and a
/// `CASCADE` edge would make removal implicit where the projection is the recorded remover.
/// The projection deletes the row when the document stops being findable, and a rebuild
/// reconciles anything a crash left behind.
///
/// `acl_subjects` / `acl_deny_subjects` are computed by the same resolver the API uses
/// (`08-permission-model.md` §7) — one implementation, two call sites, so the index can never
/// disagree with a direct read. `acl_hash` fingerprints that computation for staleness checks.
model SearchIndexEntry {
  documentId          String                  @id @map("document_id") @db.Uuid
  tenantId            String                  @map("tenant_id") @db.Uuid
  titleRaw            String                  @map("title_raw")
  /// The assigned document number, exactly as issued — matched by prefix, never stemmed.
  numberExact         String?                 @map("number_exact")
  /// Weighted lexemes: A number+title, B filename+metadata, C description, D body.
  tsv                 Unsupported("tsvector")
  /// Tenant-defined metadata values keyed by field id, for display and `meta.<fieldId>` filters.
  metadata            Json                    @default("{}")
  documentTypeId      String                  @map("document_type_id") @db.Uuid
  categoryId          String?                 @map("category_id") @db.Uuid
  status              DocumentStatus
  confidentialityRank Int                     @map("confidentiality_rank") @db.SmallInt
  entityId            String?                 @map("entity_id") @db.Uuid
  branchId            String?                 @map("branch_id") @db.Uuid
  departmentId        String?                 @map("department_id") @db.Uuid
  libraryId           String                  @map("library_id") @db.Uuid
  folderId            String                  @map("folder_id") @db.Uuid
  folderPath          String                  @map("folder_path")
  ownerId             String                  @map("owner_id") @db.Uuid
  /// Everyone who decided an approval task on this document, for `approver:` queries.
  approverIds         String[]                @map("approver_ids") @db.Uuid
  revisionOrdinal     Int?                    @map("revision_ordinal")
  revisionLabel       String?                 @map("revision_label")
  filename            String?
  /// Detected per revision, never per tenant (`12-search-architecture.md` §4).
  language            String
  /// The indexed text, stored so highlighting reads what was matched. Capped by configuration.
  body                String
  bodySource          SearchContentSource?    @map("body_source")
  /// True while the preview pipeline has not yet answered for the current revision — the
  /// materialisation of `preview_render.state`, refreshed by the events that change it, never
  /// a second status of its own (`12-search-architecture.md` §4).
  contentPending      Boolean                 @map("content_pending")
  /// True when the body is an OCR read below the confidence threshold.
  lowConfidence       Boolean                 @default(false) @map("low_confidence")
  documentCreatedAt   DateTime                @map("document_created_at") @db.Timestamptz(6)
  documentUpdatedAt   DateTime                @map("document_updated_at") @db.Timestamptz(6)
  publishedAt         DateTime?               @map("published_at") @db.Timestamptz(6)
  effectiveFrom       DateTime?               @map("effective_from") @db.Date
  aclSubjects         String[]                @map("acl_subjects")
  aclDenySubjects     String[]                @map("acl_deny_subjects")
  aclHash             String                  @map("acl_hash")
  indexedAt           DateTime                @map("indexed_at") @db.Timestamptz(6)
  /// The document's own optimistic-lock version as of projection, for staleness detection.
  sourceVersion       Int                     @map("source_version")

  @@index([tenantId, status], map: "ix_search_entry_status")
  @@index([tenantId, documentTypeId], map: "ix_search_entry_type")
  @@index([tenantId, folderPath], map: "ix_search_entry_folder_path")
  @@index([tenantId, ownerId], map: "ix_search_entry_owner")
  @@index([tenantId, documentUpdatedAt(sort: Desc)], map: "ix_search_entry_updated")
  @@map("search_index_entry")
}

/// The rebuild's build target — identical shape, swapped in when a rebuild completes.
///
/// A full rebuild writes here while readers keep answering from `search_index_entry`, then the
/// two tables trade names in one transaction (`12-search-architecture.md` §6). No reader ever
/// sees a half-built index, and no truncate ever empties the live one. Between swaps this table
/// is scratch: the next rebuild truncates it on start.
model SearchIndexEntryShadow {
  documentId          String                  @id @map("document_id") @db.Uuid
  tenantId            String                  @map("tenant_id") @db.Uuid
  titleRaw            String                  @map("title_raw")
  numberExact         String?                 @map("number_exact")
  tsv                 Unsupported("tsvector")
  metadata            Json                    @default("{}")
  documentTypeId      String                  @map("document_type_id") @db.Uuid
  categoryId          String?                 @map("category_id") @db.Uuid
  status              DocumentStatus
  confidentialityRank Int                     @map("confidentiality_rank") @db.SmallInt
  entityId            String?                 @map("entity_id") @db.Uuid
  branchId            String?                 @map("branch_id") @db.Uuid
  departmentId        String?                 @map("department_id") @db.Uuid
  libraryId           String                  @map("library_id") @db.Uuid
  folderId            String                  @map("folder_id") @db.Uuid
  folderPath          String                  @map("folder_path")
  ownerId             String                  @map("owner_id") @db.Uuid
  approverIds         String[]                @map("approver_ids") @db.Uuid
  revisionOrdinal     Int?                    @map("revision_ordinal")
  revisionLabel       String?                 @map("revision_label")
  filename            String?
  language            String
  body                String
  bodySource          SearchContentSource?    @map("body_source")
  contentPending      Boolean                 @map("content_pending")
  lowConfidence       Boolean                 @default(false) @map("low_confidence")
  documentCreatedAt   DateTime                @map("document_created_at") @db.Timestamptz(6)
  documentUpdatedAt   DateTime                @map("document_updated_at") @db.Timestamptz(6)
  publishedAt         DateTime?               @map("published_at") @db.Timestamptz(6)
  effectiveFrom       DateTime?               @map("effective_from") @db.Date
  aclSubjects         String[]                @map("acl_subjects")
  aclDenySubjects     String[]                @map("acl_deny_subjects")
  aclHash             String                  @map("acl_hash")
  indexedAt           DateTime                @map("indexed_at") @db.Timestamptz(6)
  sourceVersion       Int                     @map("source_version")

  @@index([tenantId, status], map: "ix_search_entry_shadow_status")
  @@index([tenantId, documentTypeId], map: "ix_search_entry_shadow_type")
  @@index([tenantId, folderPath], map: "ix_search_entry_shadow_folder_path")
  @@index([tenantId, ownerId], map: "ix_search_entry_shadow_owner")
  @@index([tenantId, documentUpdatedAt(sort: Desc)], map: "ix_search_entry_shadow_updated")
  @@map("search_index_entry_shadow")
}

/// One person's named, re-runnable search.
///
/// Per user: a saved search is a private shortcut, exactly as a favourite is. The phase design
/// names sharing by ACL (`12-search-architecture.md` §5); that waits for the phase that builds
/// ACL entries, because a sharing model invented before the grants exist would be a second
/// permission system.
model SavedSearch {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  ownerUserId String    @map("owner_user_id") @db.Uuid
  name        String
  /// The query text exactly as the user typed it, field syntax included.
  query       String
  /// Structured filters beside the text, in the wire shape the search endpoint takes.
  filters     Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy   String?   @map("deleted_by") @db.Uuid
  version     Int       @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  owner  User   @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  /// One name per owner among live rows — partial, in the migration; Prisma cannot express it.
  @@index([tenantId, ownerUserId, updatedAt(sort: Desc)], map: "ix_saved_search_owner")
  @@map("saved_search")
}

/// One person's recent queries, newest first, capped by configuration.
///
/// Telemetry-shaped like `document_view`: no soft delete, no version, pruned rather than
/// curated. A repeated identical search refreshes its row instead of stacking duplicates —
/// `query_hash` is the digest of the normalised query and filters that makes "identical"
/// cheap to enforce.
model RecentSearch {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  query      String
  filters    Json     @default("{}")
  queryHash  String   @map("query_hash")
  searchedAt DateTime @map("searched_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, queryHash], map: "uq_recent_search_query")
  @@index([tenantId, userId, searchedAt(sort: Desc)], map: "ix_recent_search_user")
  @@map("recent_search")
}

/// One rebuild run, which is what makes the rebuild resumable.
///
/// The cursor is the last document id the run projected into the shadow table; a resumed run
/// continues from it instead of starting over. One `RUNNING` row per tenant — partial unique,
/// in the migration — because two concurrent rebuilds would interleave into one shadow table.
model SearchRebuild {
  id               String             @id @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  state            SearchRebuildState @default(RUNNING)
  /// Keyset cursor into `document`, in id order. Null before the first batch.
  cursorDocumentId String?            @map("cursor_document_id") @db.Uuid
  documentsIndexed Int                @default(0) @map("documents_indexed")
  startedAt        DateTime           @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?          @map("completed_at") @db.Timestamptz(6)
  /// Operator-readable, set exactly when the state is FAILED.
  error            String?
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy        String?            @map("created_by") @db.Uuid
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy        String?            @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, startedAt(sort: Desc)], map: "ix_search_rebuild_tenant")
  @@map("search_rebuild")
}

// ---------------------------------------------------------------------------------------
// PHASE 10 — soft delete and retention.
//
//   `retention_schedule` and `legal_hold` are `05-database-design.md` §3's two retention tables,
//   built here for the first time. The third table has no row in that document, and it is the one
//   worth reading: `document_tombstone` exists because **audit outlives its subject** (13 §1) and
//   `audit_event` refuses `DELETE` to every role including the owner. A purge therefore leaves a
//   trail behind whose subject no longer exists, and the events written *before* this phase carry
//   no document number in their payloads — payloads that cannot be rewritten to add one, for the
//   same reason the trail is worth having. So the number and enough context to read the trail are
//   copied, at purge time, to a row the purge does not reach.
// ---------------------------------------------------------------------------------------

/// Where one document's disposition has got to.
///
/// `CANCELLED` is what a *restore* produces: a delete can create a schedule, and putting the
/// document back has to withdraw it. Leaving it `PENDING` would queue a restored document for
/// disposition; closing it `EXECUTED` would claim a disposition that never ran.
enum RetentionScheduleState {
  PENDING
  IN_REVIEW
  EXECUTED
  SUSPENDED
  CANCELLED

  @@map("retention_schedule_state")
}

/// When this record may be disposed of, and how (ADR-0010 §4).
///
/// One live schedule per document per trigger, and the disposition is copied from the policy
/// rather than read through it: ADR-0010 §7 freezes the policy onto the document so that editing
/// a policy cannot silently re-date records already kept under it, and a schedule that resolved
/// `disposition` by joining `retention_policy` at execution time would undo exactly that.
///
/// `policy_id` is nullable, and the null case is deliberate rather than lax. A document that was
/// never numbered and names no policy still has to leave the recycle bin, so its delete writes a
/// schedule whose period is the tenant's `retention.recycleBinDays`. That is the only schedule in
/// the product with no policy behind it, and `disposition` is always `PURGE` when it happens.
model RetentionSchedule {
  id             String                 @id @db.Uuid
  tenantId       String                 @map("tenant_id") @db.Uuid
  documentId     String                 @map("document_id") @db.Uuid
  /// Null for the recycle-bin window of an unnumbered draft. Never null otherwise.
  policyId       String?                @map("policy_id") @db.Uuid
  /// Which event started the clock. Part of the identity of the schedule, because a document may
  /// legitimately hold one from publication and another from its deletion.
  trigger        RetentionTrigger
  triggerAt      DateTime               @map("trigger_at") @db.Timestamptz(6)
  dueAt          DateTime               @map("due_at") @db.Timestamptz(6)
  disposition    Disposition
  state          RetentionScheduleState @default(PENDING)
  /// Copied from the policy at scheduling, and forced true for `PURGE` whatever the policy said:
  /// ADR-0010 makes review "required for irreversible ones", and purge is the irreversible one.
  reviewRequired Boolean                @default(false) @map("review_required")
  /// Who confirmed the disposition, and why. Both null until somebody does.
  reviewedById   String?                @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?              @map("reviewed_at") @db.Timestamptz(6)
  reviewNote     String?                @map("review_note")
  executedAt     DateTime?              @map("executed_at") @db.Timestamptz(6)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?                @map("created_by") @db.Uuid
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?                @map("updated_by") @db.Uuid
  version        Int                    @default(1)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document Document         @relation(fields: [documentId], references: [id], onDelete: Restrict)
  policy   RetentionPolicy? @relation(fields: [policyId], references: [id], onDelete: Restrict)

  /// The sweep's only query, and the reason it is partial: `PENDING` and `IN_REVIEW` are a
  /// handful of rows out of every schedule the tenant has ever written, and an index over the
  /// executed ones would be an index over the whole history of the library
  /// (`05-database-design.md` §3 asks for `ix (tenant_id, due_at) WHERE state = 'PENDING'`; the
  /// second state is here because a schedule waiting for a reviewer is still due).
  ///
  /// Expressed in the migration rather than here — Prisma cannot write a partial index.
  @@index([tenantId, documentId], map: "ix_retention_schedule_document")
  @@map("retention_schedule")
}

/// A suspension of disposition, absolute while it lives (ADR-0010 §5).
///
/// A row per hold rather than a flag on the document, for the same reason `document_lock` is a row:
/// who placed it, when, why, and who released it are the questions a legal hold exists to answer,
/// and a boolean answers none of them. The live hold is any row with `released_at IS NULL`, and
/// there may be several — two unrelated matters can hold the same record, and releasing one must
/// not release the other.
model LegalHold {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  documentId    String    @map("document_id") @db.Uuid
  /// Required. A hold with no stated matter is a hold nobody can ever justify releasing.
  reason        String
  placedById    String    @map("placed_by_id") @db.Uuid
  placedAt      DateTime  @map("placed_at") @db.Timestamptz(6)
  releasedAt    DateTime? @map("released_at") @db.Timestamptz(6)
  releasedById  String?   @map("released_by_id") @db.Uuid
  releaseReason String?   @map("release_reason")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?   @map("updated_by") @db.Uuid
  version       Int       @default(1)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  /// "Is this document held" — the question every delete and every disposition asks. Partial on
  /// the live rows, in the migration, because a released hold answers it with a no.
  @@index([tenantId, documentId], map: "ix_legal_hold_document")
  @@map("legal_hold")
}

/// What a purged document leaves behind so its trail is still readable.
///
/// This table is the answer to the one risk the purge creates. `13 §6` requires that "when a
/// document is purged, its audit trail remains, with the document number preserved so the record is
/// still meaningful", and `02-audit-immutability.sql` makes that enforceable rather than stated:
/// `audit_event` refuses `DELETE` to every role, so the trail *will* outlive the row whether or not
/// anybody planned for it. What it cannot do is grow a number it never carried — the events written
/// before this phase have the payloads they were hashed with, and rewriting one is the single
/// operation this product will not perform on that table.
///
/// So the number is copied here instead, at purge time, together with the few facts that make an
/// old event legible: what the document was called, what type it was, when it was deleted and when
/// it was destroyed. It is not audit data — it is mutable in principle and it carries no digest —
/// but it is the only row a purge deliberately writes rather than removes.
///
/// It carries no `deleted_at`. A tombstone that could be soft-deleted would be a tombstone the
/// recycle bin could hide, and there is nothing left to restore.
model DocumentTombstone {
  /// The purged document's own identifier, so an audit row's `subject_id` finds this by primary key.
  documentId        String    @id @map("document_id") @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  /// Reserved forever, and after the purge this is the only row that holds it beside
  /// `number_reservation` — which knows the value but not what it was issued to.
  documentNumber    String?   @map("document_number")
  title             String
  documentTypeId    String?   @map("document_type_id") @db.Uuid
  /// The type's name as it stood, not a join: the type itself may be deleted afterwards.
  documentTypeName  String?   @map("document_type_name")
  folderPath        String?   @map("folder_path")
  /// When the record was first soft-deleted, which is not when it was destroyed.
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)
  purgedAt          DateTime  @map("purged_at") @db.Timestamptz(6)
  /// Null when the scheduled sweep acted; a purge is normally nobody's act.
  purgedById        String?   @map("purged_by_id") @db.Uuid
  /// The schedule that authorised it, and the person who approved the disposition.
  scheduleId        String?   @map("schedule_id") @db.Uuid
  policyId          String?   @map("policy_id") @db.Uuid
  approvedById      String?   @map("approved_by_id") @db.Uuid
  revisionsRemoved  Int       @default(0) @map("revisions_removed")
  blobsDereferenced Int       @default(0) @map("blobs_dereferenced")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// The number stays unique among tombstones for the same reason it is unique among documents.
  @@unique([tenantId, documentNumber], map: "uq_tombstone_number")
  /// "What has this tenant destroyed, and when" — the disposition register, newest first.
  @@index([tenantId, purgedAt(sort: Desc)], map: "ix_tombstone_tenant")
  @@map("document_tombstone")
}

// =================================================================================================
// Delegation — Phase 11 (07-workflow-architecture.md §4)
// =================================================================================================

/// Where a delegation is in its life.
///
/// Five values rather than a pair of booleans, because a compliance report asks about each
/// separately: what is awaiting agreement, what is in force, what somebody refused, what was cut
/// short, and what simply ran out. A `revoked_at IS NOT NULL` on a row whose `ends_at` is also past
/// cannot say which of the last two happened, and those are different facts — one is a decision
/// somebody took and the other is a clock.
enum DelegationStatus {
  PENDING_APPROVAL
  ACTIVE
  DECLINED
  REVOKED
  EXPIRED

  @@map("delegation_status")
}

/// How a delegation came to be in force.
///
/// The column exists because an emergency delegation *bypasses the approval an ordinary one
/// requires*, and something has to say so afterwards without replaying the row's history.
enum DelegationKind {
  STANDARD
  EMERGENCY

  @@map("delegation_kind")
}

/// One person acting for another, for a bounded period, over a stated set of permissions.
///
/// A **routing overlay, never a permission grant** (§4). Nothing here grants reach: an approval
/// task is never reassigned, `assignee_id` is never rewritten, and no ACL entry may name a
/// delegation. What the row authorises is one thing only — that the delegate may take a decision on
/// a task that stays the delegator's, with both identities recorded on it.
///
/// Three properties of this table are the section's rules made unrepresentable to get wrong.
///
/// **The period is bounded and ordered** by a check constraint, so §4's "open-ended delegations are
/// refused" is the database's answer rather than a validation somebody can route around. How long
/// it may be is a tenant setting and lives in the use case, because it is policy rather than
/// structure.
///
/// **The authority is never copied here.** `permissions` is what the delegator chose to pass, not
/// what they held: §4 checks authority at decision time, so a snapshot of the delegator's grants
/// taken at creation is exactly the wrong thing to store. The delegator's current grants are read
/// when a decision is taken, and a delegation created while they held `document:approve` refuses
/// the moment their role is edited.
///
/// **Nothing is ever deleted.** Revocation and expiry are status changes, and `approval_task`
/// carries a restricting foreign key to this table — so the delegation that authorised a decision
/// is still identifiable years later, which is the one thing an investigation into a revoked
/// delegation needs and the one thing a deletion would take away.
model Delegation {
  id          String           @id @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  /// Whose authority is being passed. The task stays theirs throughout.
  delegatorId String           @map("delegator_id") @db.Uuid
  /// Who may act on it. Never an assignee, and never an ACL subject.
  delegateId  String           @map("delegate_id") @db.Uuid
  kind        DelegationKind   @default(STANDARD)
  status      DelegationStatus @default(PENDING_APPROVAL)
  /// The permission keys this delegation passes, from `@edms/domain`'s catalogue. A key that is
  /// not in the catalogue does not exist, and one the delegator does not hold refuses at use.
  permissions String[]
  startsAt    DateTime         @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime         @map("ends_at") @db.Timestamptz(6)
  /// Why it was needed. Mandatory for an emergency delegation, and the same sentence is written to
  /// `audit_event.reason` — the attested column — rather than only to a payload field.
  reason      String?
  /// Zero for a delegation of the delegator's own authority; one for a re-delegation.
  ///
  /// Stored rather than derived at read time because the rule that bounds it is evaluated against
  /// the graph as it stood when the row was written: a chain permitted at creation must not become
  /// retrospectively illegal because an unrelated delegation elsewhere expired. One hop is the
  /// maximum any setting can permit, and the check constraint says so.
  depth       Int              @default(0)

  requestedAt   DateTime  @map("requested_at") @db.Timestamptz(6)
  /// Who agreed to it — a manager of the delegator, or a delegation administrator who is party to
  /// neither side. Null for an emergency delegation, which is what the bypass looks like on the row.
  approvedById  String?   @map("approved_by_id") @db.Uuid
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz(6)
  declineReason String?   @map("decline_reason")
  revokedById   String?   @map("revoked_by_id") @db.Uuid
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason  String?   @map("revoke_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid
  /// Optimistic locking, and the revocation race's answer: a revoke and a decision arriving at the
  /// same instant serialise on the approval instance's lock, and this stops two revocations of one
  /// delegation from each believing they were the one that ended it.
  version   Int      @default(1)

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  delegator User           @relation("DelegationDelegator", fields: [delegatorId], references: [id], onDelete: Restrict)
  delegate  User           @relation("DelegationDelegate", fields: [delegateId], references: [id], onDelete: Restrict)
  tasks     ApprovalTask[]

  /// The authority predicate's own index: "which delegations let this person act, right now".
  /// Partial on the live rows, in the migration, because a tenant's delegation history is almost
  /// all of it and the question is only ever about the handful in force.
  @@index([tenantId, delegateId, status], map: "ix_delegation_delegate")
  /// "What have I given away", and the approval queue's lookup of a request's delegator.
  @@index([tenantId, delegatorId, status], map: "ix_delegation_delegator")
  /// The nightly sweep: which live delegations have run out. Partial, on `ACTIVE` rows only.
  @@index([tenantId, endsAt], map: "ix_delegation_expiry")
  @@map("delegation")
}
