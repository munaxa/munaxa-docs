// Munaxa Docs — database foundation.
//
// Phase 0.5 models only what is cross-cutting and true of every future table: the tenant
// itself, the append-only audit trail, the transactional outbox and idempotency keys.
// Documents, revisions, workflows, libraries and configuration arrive with the phases that
// own them (`docs/architecture/05-database-design.md` is the target design).
//
// The conventions below are the contract every later model follows:
//
//   id            uuid, v7, generated by the application — time-ordered, so index locality
//                 survives without exposing a guessable sequence
//   tenant_id     on every business table; the only exception is `tenant` itself
//   created_at / updated_at         timestamptz, UTC
//   created_by / updated_by         the acting user; never inferred at read time
//   deleted_at / deleted_by         soft delete — NULL means live
//   version       optimistic locking on every aggregate root
//   naming        snake_case, singular table names, ix_/uq_/fk_/ck_ prefixes
//
// Every unique constraint on soft-deletable data is partial (`WHERE deleted_at IS NULL`), so
// a deleted row never blocks a new one. The one deliberate exception is a document's number,
// which stays reserved forever precisely so it can never be re-issued.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CLOSED

  @@map("tenant_status")
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILED

  @@map("audit_outcome")
}

enum AuditSubjectType {
  DOCUMENT
  REVISION
  FOLDER
  LIBRARY
  USER
  ROLE
  WORKFLOW
  TASK
  CONFIGURATION
  SESSION
  FILE

  @@map("audit_subject_type")
}

enum ActorChannel {
  WEB
  API
  WORKER
  SYSTEM

  @@map("actor_channel")
}

/// The customer organisation. The only table without a `tenant_id`, because it *is* the
/// tenant — and therefore the only table not covered by a row-level security policy keyed on
/// `current_setting('app.tenant_id')`.
model Tenant {
  id        String       @id @db.Uuid
  slug      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  /// Locale, timezone, branding and security policy. `jsonb` because the shape is genuinely
  /// tenant-defined — never as a way to avoid modelling something the product knows about.
  settings  Json         @default("{}")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?    @map("deleted_at") @db.Timestamptz(6)

  auditEvents AuditEvent[]
  outbox      OutboxMessage[]
  idempotency IdempotencyKey[]
  users       User[]
  roles       Role[]
  sessions    SessionFamily[]
  notificationTemplates NotificationTemplate[]
  notifications         NotificationMessage[]
  companies             Company[]
  entities              Entity[]
  branches              Branch[]
  departments           Department[]

  @@index([status], map: "ix_tenant_status")
  @@map("tenant")
}

/// Append-only and hash-chained.
///
/// Each row's `hash` covers `previous_hash`, so removing or editing any event breaks every
/// digest after it. The application role is granted `INSERT` and `SELECT` only — no `UPDATE`,
/// no `DELETE` — and a database trigger rejects both regardless of grants
/// (`infra/sql/02-audit-immutability.sql`).
///
/// Audit outlives its subject: it is never soft-deleted, and a purged document leaves its
/// trail behind. There is deliberately no `deleted_at` on this model.
model AuditEvent {
  id           String           @id @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  /// Per-tenant, monotonic and **gap-free** (`13-audit-architecture.md` §3).
  ///
  /// The hash chain proves that no record was altered, but on its own it cannot prove that
  /// none was removed from the end: truncate the last k events and what remains still chains
  /// perfectly. A contiguous sequence is what makes a hole visible, and it is why this is
  /// allocated as `max + 1` under a per-tenant advisory lock rather than from a PostgreSQL
  /// sequence — those gap on rollback, and a gap is indistinguishable from a deletion.
  sequence     BigInt
  occurredAt   DateTime         @map("occurred_at") @db.Timestamptz(6)
  /// Null when the system acted alone — a retention purge, a scheduled verification.
  actorId      String?          @map("actor_id") @db.Uuid
  /// Recorded when the actor was acting under a delegation. Both people are in the trail.
  onBehalfOfId String?          @map("on_behalf_of_id") @db.Uuid
  channel      ActorChannel
  action       String
  subjectType  AuditSubjectType @map("subject_type")
  subjectId    String           @map("subject_id") @db.Uuid
  outcome      AuditOutcome
  /// Minimised: enough to reconstruct what happened, never a document's content and never a
  /// personal identifier that is not already in the subject.
  payload      Json             @default("{}")
  /// Required where a confidentiality level or policy demands a stated reason for access.
  reason       String?
  correlationId String          @map("correlation_id")
  ipAddress    String?          @map("ip_address")
  userAgent    String?          @map("user_agent")
  hash         String           @db.Char(64)
  previousHash String           @map("previous_hash") @db.Char(64)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// The document timeline and the subject-scoped audit tab.
  @@index([tenantId, subjectType, subjectId, occurredAt(sort: Desc)], map: "ix_audit_subject")
  /// "What did this person do", for an investigation.
  @@index([tenantId, actorId, occurredAt(sort: Desc)], map: "ix_audit_actor")
  /// Chain verification walks in occurrence order; also the partition key when the table is
  /// range-partitioned by month.
  @@index([tenantId, occurredAt], map: "ix_audit_occurred")
  /// Ties an event back to the request that produced it, across API, worker and logs.
  @@index([correlationId], map: "ix_audit_correlation")
  /// The chain's order, and the constraint that makes a duplicate sequence impossible even if
  /// two writers somehow bypass the advisory lock.
  @@unique([tenantId, sequence], map: "uq_audit_tenant_sequence")
  @@map("audit_event")
}

/// The transactional outbox.
///
/// A use case writes a row here inside its own transaction; the dispatcher claims unsent rows
/// with `FOR UPDATE SKIP LOCKED` after commit and enqueues them. Nothing is published to a
/// queue inside a transaction
/// (`docs/architecture/adr/0011-transactional-outbox-for-async-work.md`).
model OutboxMessage {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type")
  /// Payload contract version. A shipped shape never changes; a different shape is a new
  /// version, and consumers keep handling the old one until nothing emits it.
  eventVersion  Int       @default(1) @map("event_version")
  payload       Json
  correlationId String    @map("correlation_id")
  /// Lets an event be published now and delivered later — a reminder, a deferred digest.
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// The dispatcher's only query: unprocessed rows that are due. Partial, so the index stays
  /// small even though the table holds every event ever published for the last seven days.
  @@index([availableAt], map: "ix_outbox_pending")
  @@index([aggregateType, aggregateId], map: "ix_outbox_aggregate")
  @@map("outbox_message")
}

/// Stored responses for replayed mutating requests.
///
/// A client cannot tell a lost response from a lost request, so a retry is normal rather than
/// exotic. Keyed by `(tenant_id, key)`: one tenant's key can never replay into another's
/// (`docs/architecture/15-api-architecture.md` §2).
model IdempotencyKey {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  key          String
  /// Method and path, so the same key on a different endpoint is a client bug, not a replay.
  requestPath  String   @map("request_path")
  requestMethod String  @map("request_method")
  /// Fingerprint of the request body; a reused key with different content is rejected rather
  /// than answered with someone else's result.
  requestHash  String   @map("request_hash") @db.Char(64)
  statusCode   Int      @map("status_code")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key], map: "uq_idempotency_tenant_key")
  @@index([expiresAt], map: "ix_idempotency_expiry")
  @@map("idempotency_key")
}

// ---------------------------------------------------------------------------------------
// Identity — Phase 1.
//
// Users, roles, the role→permission matrix and refresh-token sessions. Object-level reach
// (which folder, which library) is not here: it is resolved per request against the scope
// tree by the ACL resolver, so revoking access takes effect on the next call rather than at
// the next token refresh (`docs/architecture/08-permission-model.md` §3).
// ---------------------------------------------------------------------------------------

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED

  @@map("user_status")
}

/// How a stored password was derived. Recorded per row so the parameters can be raised
/// without invalidating every existing credential: a user whose row names an older algorithm
/// is transparently re-hashed on their next successful sign-in.
enum PasswordAlgorithm {
  SCRYPT

  @@map("password_algorithm")
}

/// A person who can sign in.
///
/// `emailNormalized` is the lookup key and the uniqueness key; `email` preserves what the
/// user typed. The unique index is partial on `deleted_at IS NULL`, so deleting a user frees
/// their address for re-invitation — the general rule for soft-deletable data.
model User {
  id                String     @id @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  email             String
  /// Lower-cased and trimmed. Never shown; only matched against.
  emailNormalized   String     @map("email_normalized")
  displayName       String     @map("display_name")
  status            UserStatus @default(INVITED)
  /// Null for an invited user who has not yet set one, and for a user who authenticates
  /// through a federated issuer. Absence is never a reason to allow a sign-in.
  passwordHash      String?    @map("password_hash")
  passwordAlgorithm PasswordAlgorithm? @map("password_algorithm")
  passwordUpdatedAt DateTime?  @map("password_updated_at") @db.Timestamptz(6)
  mfaEnrolled       Boolean    @default(false) @map("mfa_enrolled")
  /// Bumped whenever this user's roles or permissions change. An access token carrying an
  /// older value is refused, so a revoked role takes effect within one request rather than
  /// at the end of the token's lifetime.
  permissionVersion Int        @default(1) @map("permission_version")
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String?    @map("created_by") @db.Uuid
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy         String?    @map("updated_by") @db.Uuid
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz(6)
  deletedBy         String?    @map("deleted_by") @db.Uuid
  /// Optimistic locking. Two administrators editing the same user do not silently overwrite.
  version           Int        @default(1)

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roles    UserRole[]
  sessions SessionFamily[]
  notificationPreferences NotificationPreference[]
  notifications           NotificationMessage[]
  departments             UserDepartment[]

  @@index([tenantId, emailNormalized], map: "ix_user_email")
  @@index([tenantId, status], map: "ix_user_status")
  @@map("user")
}

/// A named bundle of permissions.
///
/// The eight `SystemRole` keys are seeded into every tenant and cannot be renamed or deleted,
/// because the product refers to them by key. Their *permissions* are tenant data and may be
/// edited — a tenant whose approvers must also publish should not need a release.
model Role {
  id          String  @id @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  key         String
  name        String
  description String?
  /// Seeded by the product. Blocks deletion and renaming of the key, not of the permissions.
  isSystem    Boolean @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy   String?   @map("deleted_by") @db.Uuid
  version     Int       @default(1)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  users       UserRole[]

  @@index([tenantId], map: "ix_role_tenant")
  @@map("role")
}

/// One permission granted to one role.
///
/// A row per grant rather than an array column, so revoking a single permission is a delete
/// and the matrix is queryable — "which roles can approve" is a question the product asks.
/// `permission` is validated against the catalogue in `@edms/domain` before it is written;
/// the database deliberately does not carry an enum of them, because adding a permission
/// would then require a migration in lockstep with the code that uses it.
model RolePermission {
  tenantId   String @map("tenant_id") @db.Uuid
  roleId     String @map("role_id") @db.Uuid
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@index([tenantId, permission], map: "ix_role_permission_lookup")
  @@map("role_permission")
}

/// A role held by a user.
model UserRole {
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedBy String?  @map("assigned_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([tenantId, roleId], map: "ix_user_role_by_role")
  @@map("user_role")
}

/// One sign-in, and the chain of refresh tokens it issued.
///
/// The family is the unit of revocation. Refresh tokens rotate: each use issues a successor
/// and marks its predecessor used. Presenting an already-used token means the token was
/// stolen — either the thief or the legitimate holder is replaying it, and there is no way to
/// tell which — so the whole family is revoked and both parties must sign in again
/// (`docs/architecture/17-security-architecture.md` §2).
model SessionFamily {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Set when the family is revoked: by sign-out, by password change, or by token reuse.
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?  @map("revoked_reason")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens RefreshToken[]

  @@index([tenantId, userId], map: "ix_session_family_user")
  @@map("session_family")
}

/// A single refresh token, stored only as a hash.
///
/// The plaintext exists in the client's cookie and nowhere else: a database disclosure must
/// not hand over live sessions. Lookup is by hash, which is why the hash is unique.
model RefreshToken {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  familyId    String    @map("family_id") @db.Uuid
  tokenHash   String    @map("token_hash") @db.Char(64)
  issuedAt    DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Set the moment the token is exchanged. A second exchange is reuse, and kills the family.
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)

  family SessionFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([tokenHash], map: "uq_refresh_token_hash")
  @@index([familyId], map: "ix_refresh_token_family")
  @@index([expiresAt], map: "ix_refresh_token_expiry")
  @@map("refresh_token")
}

// ---------------------------------------------------------------------------------------
// Notification — Phase 1.
//
// The framework: what was sent, to whom, on which channel, and what each person asked for.
// Templates ship with the product (`modules/notification/domain/default-templates.ts`); rows
// here are tenant *overrides*, so a tenant that has customised nothing still gets correct,
// translated notifications (`docs/architecture/18-notification-architecture.md` §6).
// ---------------------------------------------------------------------------------------

enum NotificationChannel {
  EMAIL
  IN_APP
  SMS
  PUSH
  WEBHOOK

  @@map("notification_channel")
}

enum DeliveryState {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SUPPRESSED

  @@map("delivery_state")
}

enum DigestFrequency {
  IMMEDIATE
  HOURLY
  DAILY
  WEEKLY

  @@map("digest_frequency")
}

/// A tenant's override of a shipped template.
///
/// Absence means "use the product's". That is why there is no seeding step: an empty table is
/// a fully working tenant, and a row exists only where somebody deliberately changed something.
model NotificationTemplate {
  id        String              @id @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  /// The notification type key, e.g. `security.session.revoked`.
  typeKey   String              @map("type_key")
  channel   NotificationChannel
  locale    String
  subject   String
  bodyText  String              @map("body_text")
  /// Null for channels with no HTML — in-app, SMS.
  bodyHtml  String?             @map("body_html")
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?             @map("created_by") @db.Uuid
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?             @map("updated_by") @db.Uuid
  version   Int                 @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, typeKey, channel, locale], map: "uq_notification_template")
  @@map("notification_template")
}

/// What one person asked to receive, and how often.
///
/// A missing row means "no opinion", never "off": the type's own defaults apply, and a
/// mandatory type is delivered regardless (§5).
model NotificationPreference {
  tenantId String                @map("tenant_id") @db.Uuid
  userId   String                @map("user_id") @db.Uuid
  typeKey  String                @map("type_key")
  channels NotificationChannel[]
  digest   DigestFrequency       @default(IMMEDIATE)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, typeKey])
  @@index([tenantId, typeKey], map: "ix_notification_preference_type")
  @@map("notification_preference")
}

/// One notification, to one person, on one channel.
///
/// The rendered subject and body are stored rather than re-rendered at delivery: what was sent
/// is a fact, and a template edited afterwards must not change what the record says was sent.
///
/// In-app delivery *is* this row — there is no adapter, which is why a mail provider outage
/// never affects it (§7).
model NotificationMessage {
  id             String              @id @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  recipientId    String              @map("recipient_id") @db.Uuid
  typeKey        String              @map("type_key")
  channel        NotificationChannel
  locale         String
  /// The channel address this went to, captured when the message was created.
  ///
  /// Stored rather than looked up at delivery: what was sent, and where, is a fact. A person
  /// who changes their email afterwards must not retroactively change the record of what was
  /// already sent to the old one.
  address        String
  subject        String
  bodyText       String              @map("body_text")
  bodyHtml       String?             @map("body_html")
  state          DeliveryState       @default(QUEUED)
  attempts       Int                 @default(0)
  /// Deterministic per (event, recipient, channel). A second delivery attempt for the same
  /// key is a no-op rather than a duplicate in somebody's inbox (§7).
  idempotencyKey String              @map("idempotency_key")
  failureReason  String?             @map("failure_reason")
  sentAt         DateTime?           @map("sent_at") @db.Timestamptz(6)
  readAt         DateTime?           @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recipient User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey], map: "uq_notification_idempotency")
  /// The inbox query: one person's unread, newest first.
  @@index([tenantId, recipientId, readAt, createdAt(sort: Desc)], map: "ix_notification_inbox")
  /// The dispatcher's claim query.
  @@index([tenantId, state, createdAt], map: "ix_notification_pending")
  @@map("notification_message")
}

// ---------------------------------------------------------------------------------------
// Organisation — Phase 1.
//
// The scope tree: TENANT → COMPANY → ENTITY → DEPARTMENT (nesting), which is the chain the
// ACL resolver walks (`packages/domain/src/scope.ts`, `08-permission-model.md` §3).
//
// `branch` is deliberately **not** a level of that chain. It is a location — its code appears
// in document numbers and a department may sit at one — but permission does not flow through
// it. Adding it to the chain would give every ACL an extra level nobody grants on.
// ---------------------------------------------------------------------------------------

/// The top of a tenant's tree. Most tenants have one; a group with separate legal books has
/// several, which is why this is a table and not a column on `tenant`.
model Company {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  code      String
  name      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  version   Int       @default(1)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entities Entity[]

  @@index([tenantId], map: "ix_company_tenant")
  @@map("company")
}

/// A legal entity within a company. Owns branches and departments.
model Entity {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  code      String
  name      String
  legalName String?   @map("legal_name")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  version   Int       @default(1)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branches    Branch[]
  departments Department[]

  @@index([tenantId, companyId], map: "ix_entity_company")
  @@map("entity")
}

/// A physical location. Its code appears in document numbers, which is why it is modelled
/// rather than left as an address string on a department.
model Branch {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  entityId  String    @map("entity_id") @db.Uuid
  code      String
  name      String
  address   String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  version   Int       @default(1)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entity      Entity       @relation(fields: [entityId], references: [id], onDelete: Restrict)
  departments Department[]

  @@index([tenantId, entityId], map: "ix_branch_entity")
  @@map("branch")
}

/// A department, which may nest inside another department.
///
/// `path` materialises the ancestry so resolving an ACL is one indexed query rather than a
/// recursive CTE on every request (`05-database-design.md` §8). It is derived data, maintained
/// by the application whenever a department is created or moved, and it is stored as `text`
/// rather than `ltree` — see ADR-0014 for why, and for what that costs.
model Department {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  entityId  String    @map("entity_id") @db.Uuid
  /// Null for a department that is not tied to a location.
  branchId  String?   @map("branch_id") @db.Uuid
  /// Null for a department directly under the entity.
  parentId  String?   @map("parent_id") @db.Uuid
  code      String
  name      String
  /// Dot-separated ancestor identifiers, this department last. Never written by hand.
  path      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  version   Int       @default(1)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entity   Entity           @relation(fields: [entityId], references: [id], onDelete: Restrict)
  branch   Branch?          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  parent   Department?      @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Department[]     @relation("DepartmentTree")
  members  UserDepartment[]

  @@index([tenantId, entityId], map: "ix_department_entity")
  /// The subtree query: every descendant of a node, by prefix.
  @@index([tenantId, path], map: "ix_department_path")
  @@map("department")
}

/// Which departments a person belongs to.
///
/// One is primary, and it drives routing and numbering defaults — which is why it is a flag
/// here rather than a separate column on the user: a person can move between departments
/// without rewriting their record.
model UserDepartment {
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  isPrimary    Boolean  @default(false) @map("is_primary")
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedBy   String?  @map("assigned_by") @db.Uuid

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([userId, departmentId])
  @@index([tenantId, departmentId], map: "ix_user_department_by_department")
  @@map("user_department")
}
