{
  "name": "munaxa-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Munaxa Docs \u2014 an independent Munaxa product repository. Consumes the shared design system from @munaxa/*.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "verify:styles": "turbo run verify:styles",
    "test:visual": "turbo run test:visual",
    "dev": "turbo run dev",
    "lint": "pnpm format:check && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev && pnpm db:post-migrate",
    "prisma:deploy": "node scripts/migrate-tenants.mjs",
    "db:post-migrate": "node scripts/apply-post-migrate.mjs"
  },
  "devDependencies": {
    "@munaxa/config-eslint": "^1.0.0",
    "@munaxa/config-typescript": "^1.0.0",
    "@prisma/client": "^6.19.3",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@nestjs/core",
      "sharp",
      "unrs-resolver"
    ]
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
