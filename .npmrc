auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false
engine-strict=true

# The shared platform is published from munaxa-platform to GitHub Packages.
# Only the scope→registry mapping lives here. The credential is deliberately NOT in
# this file: pnpm refuses to expand env vars in auth settings from a committed .npmrc
# (a PR could repoint them at an attacker-controlled registry), so each environment
# injects it at the user level with a token that has `read:packages` on the munaxa org:
#   CI:      actions/setup-node registry-url + NODE_AUTH_TOKEN (see .github/workflows)
#   Local:   pnpm config set "//npm.pkg.github.com/:_authToken" <token>
@munaxa:registry=https://npm.pkg.github.com
