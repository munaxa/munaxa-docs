auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false
engine-strict=true

# The shared platform is published from munaxa-platform to GitHub Packages.
# Authenticate with a token that has `read:packages` on the tam2om org:
#   export GITHUB_TOKEN=<token>            (locally, e.g. via direnv)
#   GITHUB_TOKEN in CI                     (see .github/workflows/ci.yml)
@munaxa:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
